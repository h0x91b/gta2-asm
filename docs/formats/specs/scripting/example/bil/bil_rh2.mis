// starts Russian hard phone1 mission2


russ_hard_phone_m2:

SET flag_failed_russ_hard_phone_m2 = 0



DISPLAY_MESSAGE ( 3860 ) // you have PASSED the mission!"
DISPLAY_BRIEF ( 3960 ) // "A few of my men had some information for me, but they ran into the Zaibatsu! They are being held at the Power Core, get over there!"
SET flag_on_mission = 1
SET flag_on_russ_mission = 1

SET_PEDDENSITY ( B08 , 0 )
//
POINT_ARROW_AT ( arrow , 25.0 , 243.0 , 4.0 )


r_h_2_powerup_1 = CREATE_OBJ ( 6.5 , 239.0 , 5.0 ) 0 COLLECT_04 15 END
r_h_2_powerup_2 = CREATE_OBJ ( 47.5 , 239.0 , 5.0 ) 0 COLLECT_31 END
