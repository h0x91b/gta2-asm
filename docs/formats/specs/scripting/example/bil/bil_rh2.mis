		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader , goto_area_on_foot , 186.0 , 3.5 , 2.0 )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_2 )
		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader_2 , goto_area_on_foot , 186.5 , 3.5 , 2.0 )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_3 )
		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader_3 , goto_area_on_foot , 187.0 , 3.5 , 2.0 )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_4 )
		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader_4 , goto_area_on_foot , 187.5 , 3.5 , 2.0 )  
	ENDIF


	IF ( ( ( ( r_h_2_group_2_leader_obj_1 = 2 ) 
	AND ( IS_CHAR_OBJECTIVE_PASSED ( r_h_2_group_2_leader_2 ) ) )
	AND ( IS_CHAR_OBJECTIVE_PASSED ( r_h_2_group_2_leader_3 ) ) )
	AND ( IS_CHAR_OBJECTIVE_PASSED ( r_h_2_group_2_leader_4 ) ) )
		SET r_h_2_group_2_leader_obj_1 = 3
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF_NOW ( 3470 ) // "What the fuck happened to you? Where are my men? All you had to do was drop them off!
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader )
		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader , wait_on_foot )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_2 )
		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader_2 , wait_on_foot )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_3 )
		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader_3 , wait_on_foot )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_4 )
		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader_4 , wait_on_foot )  
		GIVE_WEAPON ( r_h_2_flame_guy , flame_thrower )
		SET_CHAR_OBJECTIVE ( r_h_2_flame_guy , kill_char_on_foot , r_h_2_target_ped )
		SET_CHAR_INVINCIBLE ( r_h_2_target_ped , OFF )
		#ifdef PC
		DELETE_ITEM ( r_h_2_laugh )
		r_h_2_scream = CREATE_SOUND ( 185.5 , 5.5 , 6.0 ) scream play_instant END
		FORCE_CLEANUP ( r_h_2_scream )
		#endif 	  
	ENDIF


	IF ( ( HAS_CHARACTER_DIED ( r_h_2_target_ped ) )
	AND ( r_h_2_group_2_leader_obj_1 = 3 ) )
		MAKE_CHAR_DO_NOTHING ( r_h_2_flame_guy )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_2 )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_3 )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader_4 )
		MAKE_CHAR_DO_NOTHING ( r_h_2_flame_guy )
		MAKE_CHAR_DO_NOTHING ( r_h_2_group_2_leader )
//		SET_CHAR_OBJECTIVE ( r_h_2_flame_guy , no_obj )  
//		SET_CHAR_OBJECTIVE ( r_h_2_group_2_leader , no_obj )  
		SET	r_h_2_target_ped_flamed_2 = 1
	ENDIF


ENDWHILE

	
IF ( flag_passed_russ_hard_phone_m2 = 0 )  
	DISPLAY_BRIEF ( 3471 ) // "you have stayed alive and passed my test. Well done"
	SET flag_passed_russ_hard_phone_m2 = 1
	++ counter_all_missions_passed
	DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
	ADD_SCORE ( shaft , 80000 )
	ADD_MULTIPLIER ( shaft , 1 ) 
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( russgang , shaft , 1 )
	CLEAR_WANTED_LEVEL ( shaft )
 	IF ( flag_passed_russ_hard_phone_m1 = 1 )
		SET_PHONE_DEAD ( ph_russ_hard_phone ) 
		DISABLE_THREAD_TRIGGER ( thr_russ_hard_phone_m1 )
	ENDIF
	RETURN
ENDIF


//------------------------------------------------------------------------------------------
//------------------------------------------------------------------------------------------



// deletes all objects when Russian hard phone mission2 is finished...
				
clean_up_russ_hard_phone_m2: 
	
	REMOVE_ARROW ( arrow )
	REMOVE_ARROW ( arrow_2 )
	REMOVE_ARROW ( arrow_3 )
	REMOVE_ARROW ( arrow_4 )
	
	SET_PEDDENSITY ( B08 , 400 )
	OPEN_DOOR ( r_h_2_door_1_1 )
	#ifdef PC
	OPEN_DOOR ( r_h_2_door_1_2 )
	#endif


	IF ( r_h_2_in_fbi_car_remap = 1 )
		SET_CHAR_GRAPHIC_TYPE  ( shaft , gang_graphic , 25 )
	ENDIF

	IF ( flag_passed_russ_hard_phone_m2 = 1 )
		++ flag_russ_missions_passed
		++ flag_all_missions_passed
		IF ( flag_russ_missions_passed = 7 )
			DISPLAY_BRIEF ( 3673 ) // "Good work that should stop them building into our community"
			DISPLAY_MESSAGE ( 3672 ) // you have PASSED the mission!"
		ENDIF
	ENDIF

	IF ( flag_failed_russ_hard_phone_m2 = 1 )
		++ flag_russ_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( russgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
	ENDIF

	IF ( CHECK_DEATHARREST_EXECUTED ( ) )
		++ flag_russ_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( russgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
	ENDIF

	MISSION_HAS_FINISHED ( )

	SET flag_on_mission	= 0
	SET flag_on_russ_mission = 0
	
	RETURN



MISSIONSTART

	GOSUB russ_hard_phone_m2:

	GOSUB clean_up_russ_hard_phone_m2:

MISSIONEND

			
					 
