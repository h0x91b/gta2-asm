	// generator 4 destroyed
	
	IF ( ( CHECK_OBJ_MODEL ( r_h_2_generator_4 , powergen_dead ) )
	AND	( r_h_2_generator_4_destroyed = 0 ) )
		++ r_h_2_generators_destroyed
		SET r_h_2_generator_4_destroyed = 1
		#ifdef PC
