		EXPLODE_NO_RING ( 49.5 , 251.5 , 6.0 )
		++ r_h_2_generators_destroyed_2
	ENDIF
	
 
	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( r_h_2_generator_1_guard ) ) 
   	AND ( r_h_2_generator_1_guard_spotted_player = 0 ) )
		SET r_h_2_generator_1_guard_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3966 ) // "Keep away from the generators!"	 
	ENDIF

	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( r_h_2_generator_2_guard ) ) 
   	AND ( r_h_2_generator_2_guard_spotted_player = 0 ) )
		SET r_h_2_generator_2_guard_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3967 ) // "Where the fuck did you come from!"	 
	ENDIF

	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( r_h_2_generator_3_guard ) ) 
   	AND ( r_h_2_generator_3_guard_spotted_player = 0 ) )
		SET r_h_2_generator_3_guard_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3968 ) // "I'm gonna bloe your fuckin face off!"	 
