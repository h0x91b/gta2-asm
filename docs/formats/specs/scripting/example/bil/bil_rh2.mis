FORCE_CLEANUP ( r_h_2_powerup_4 )
FORCE_CLEANUP ( r_h_2_powerup_5 )

r_h_2_generator_1 = CREATE_OBJ ( 4.5 , 226.5 , 5.0 ) 0 powergen END
r_h_2_generator_2 = CREATE_OBJ ( 49.5 , 226.5 , 5.0 ) 0 powergen END
r_h_2_generator_3 = CREATE_OBJ ( 4.5 , 251.5 , 5.0 ) 0 powergen END
r_h_2_generator_4 = CREATE_OBJ ( 49.5 , 251.5 , 5.0 ) 0 powergen END
#ifdef PC
r_h_2_generator_4_sound = CREATE_SOUND ( 49.5 , 251.5 , 5.0 ) generator_rumble play_forever END
r_h_2_generator_1_sound = CREATE_SOUND ( 4.5 , 226.5 , 5.0 ) generator_rumble play_forever END
r_h_2_generator_2_sound = CREATE_SOUND ( 49.5 , 226.5 , 5.0 ) generator_rumble play_forever END
