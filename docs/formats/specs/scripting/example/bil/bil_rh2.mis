#endif



WHILE_EXEC ( NOT ( LOCATE_CHARACTER_ANY_MEANS ( shaft , 25.0 , 243.0 , 4.0 , 2.0 , 2.0  ) ) )
   	
	
	DO_NOWT
	

ENDWHILE


REMOVE_ARROW ( arrow )
DISPLAY_BRIEF_NOW ( 3962 ) // "Shit the door's locked. Try taking out the generators! That should drain enough power to open the doors!"
POINT_ARROW_AT ( arrow , r_h_2_generator_1 )
POINT_ARROW_AT ( arrow_2 , r_h_2_generator_2 )
POINT_ARROW_AT ( arrow_3 , r_h_2_generator_3 )
POINT_ARROW_AT ( arrow_4 , r_h_2_generator_4 )
//
//
WHILE_EXEC ( ( r_h_2_generators_destroyed < 4 )
AND ( r_h_2_generators_destroyed_2 < 4 ) )

	
	// generator 1 destroyed
	
	IF ( ( CHECK_OBJ_MODEL ( r_h_2_generator_1 , powergen_dead ) )
	AND	( r_h_2_generator_1_destroyed = 0 ) )
		++ r_h_2_generators_destroyed
		SET r_h_2_generator_1_destroyed = 1
		#ifdef PC
		DELETE_ITEM ( r_h_2_generator_1_sound )
		#endif
		REMOVE_ARROW ( arrow )
		IF ( NOT ( HAS_CHARACTER_DIED ( r_h_2_generator_1_guard ) ) ) 	
			SET_CHAR_OBJECTIVE ( r_h_2_generator_1_guard , kill_char_on_foot , shaft )   
		ENDIF
		#ifdef PC
		IF ( NOT ( HAS_CHARACTER_DIED ( r_h_2_patrol_guard_1 ) ) ) 	
			SET_CHAR_OBJECTIVE ( r_h_2_patrol_guard_1 , kill_char_on_foot , shaft )   
		ENDIF
		#endif
		IF ( r_h_2_generators_destroyed = 1 )
			DISPLAY_BRIEF ( 3963 ) // "Good work, you've destroyed one of the generators, now get the rest of them!"
		ELSE
			IF ( r_h_2_generators_destroyed = 2 )
				DISPLAY_BRIEF ( 3964 ) // "Well done, that's two out, two to go!"
			ELSE
				IF ( r_h_2_generators_destroyed = 3 )
					DISPLAY_BRIEF ( 3965 ) // "Nice shooting! Destroy the last one and the doors should open!"
				ENDIF
			ENDIF
		ENDIF	
	ENDIF


	IF ( ( r_h_2_generator_1_destroyed = 1 ) 
	AND ( NOT ( DELAY ( 15 ) ) ) ) 
		SET r_h_2_generator_1_destroyed = 2
		EXPLODE_NO_RING ( 4.5 , 226.5 , 4.0 )
	ENDIF


	IF ( ( r_h_2_generator_1_destroyed = 2 ) 
	AND ( NOT ( DELAY ( 15 ) ) ) ) 
		SET r_h_2_generator_1_destroyed = 3
		EXPLODE_NO_RING ( 4.5 , 226.5 , 6.0 )
		++ r_h_2_generators_destroyed_2
	ENDIF


	// generator 2 destroyed
	
	IF ( ( CHECK_OBJ_MODEL ( r_h_2_generator_2 , powergen_dead ) )
	AND	( r_h_2_generator_2_destroyed = 0 ) )
		++ r_h_2_generators_destroyed
		SET r_h_2_generator_2_destroyed = 1
		#ifdef PC
		DELETE_ITEM ( r_h_2_generator_2_sound )
		#endif
		REMOVE_ARROW ( arrow_2 )
		IF ( NOT ( HAS_CHARACTER_DIED ( r_h_2_generator_2_guard ) ) ) 	
			SET_CHAR_OBJECTIVE ( r_h_2_generator_2_guard , kill_char_on_foot , shaft )   
		ENDIF
		#ifdef PC
		IF ( NOT ( HAS_CHARACTER_DIED ( r_h_2_patrol_guard_2 ) ) ) 	
			SET_CHAR_OBJECTIVE ( r_h_2_patrol_guard_2 , kill_char_on_foot , shaft )   
		ENDIF
		#endif
		IF ( r_h_2_generators_destroyed = 1 )
			DISPLAY_BRIEF ( 3963 ) // "Good work, you've destroyed one of the generators, now get the rest of them!"
		ELSE
			IF ( r_h_2_generators_destroyed = 2 )
				DISPLAY_BRIEF ( 3964 ) // "Well done, that's two out, two to go!"
			ELSE
				IF ( r_h_2_generators_destroyed = 3 )
					DISPLAY_BRIEF ( 3965 ) // "Nice shooting! Destroy the last one and the doors should open!"
				ENDIF
			ENDIF
		ENDIF	
	ENDIF


	IF ( ( r_h_2_generator_2_destroyed = 1 ) 
	AND ( NOT ( DELAY ( 15 ) ) ) ) 
		SET r_h_2_generator_2_destroyed = 2
		EXPLODE_NO_RING ( 49.5 , 226.5 , 4.0 )
	ENDIF


	IF ( ( r_h_2_generator_2_destroyed = 2 ) 
	AND ( NOT ( DELAY ( 15 ) ) ) ) 
		SET r_h_2_generator_2_destroyed = 3
		EXPLODE_NO_RING ( 49.5 , 226.5 , 6.0 )
		++ r_h_2_generators_destroyed_2
	ENDIF


	// generator 3 destroyed
	
	IF ( ( CHECK_OBJ_MODEL ( r_h_2_generator_3 , powergen_dead ) )
	AND	( r_h_2_generator_3_destroyed = 0 ) )
		++ r_h_2_generators_destroyed
		SET r_h_2_generator_3_destroyed = 1
		#ifdef PC
		DELETE_ITEM ( r_h_2_generator_3_sound )
		#endif
