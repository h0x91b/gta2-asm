		// WAIT IN HERE UNTIL PLAYER HAS RESPAWNED 
		WHILE ( NOT ( CHECK_CHARACTER_HEALTH ( shaft , 100 ) ) ) 
			DO_NOWT
			ENDEXEC
		ENDWHILE

		SET deathtimer = 0
		WHILE (deathtimer < 100 ) 
			++ deathtimer
			ENDEXEC
		ENDWHILE
//		SET_DEATHARREST_STATE ( shaft , ON ) 
	ENDIF

	
	/*
	IF ( ( ( ( HAS_CHARACTER_DIED ( shaft ) )
	AND ( k_m_3_player_dead < 1 ) )
	AND ( k_m_3_all_generators_destroyed = 3 ) )
	AND ( flag_failed_kris_med_phone1_2_m3 = 0 ) )
		SET flag_failed_kris_med_phone1_2_m3 = 1
		DISPLAY_BRIEF ( 3367 ) // "You killed all of my new men, you have failed me!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF
*/	

	IF ( ( k_m_3_armoured_truck_1_created = 2 )
	AND ( k_m_3_player_in_armoured_truck_1 = 0 ) )
		IF ( IS_CHARACTER_IN_CAR ( shaft , k_m_3_armoured_truck_1 ) ) 
			SET k_m_3_player_in_armoured_truck_1 = 1
			DISPLAY_BRIEF ( 3368 ) // "Ok get back over there, the tanks can't harm you now!"
   			POINT_ARROW_AT ( arrow , k_m_3_pickup_group_1_leader )
		ENDIF
   	ENDIF

	
	// if player gets out of car points back at car and says to get back in
		
   	IF ( ( k_m_3_armoured_truck_1_created = 2 )
   	AND ( k_m_3_player_in_armoured_truck_1 = 1 ) )
		IF ( NOT ( IS_CHARACTER_IN_CAR ( shaft , k_m_3_armoured_truck_1 ) ) ) 
			SET k_m_3_player_in_armoured_truck_1 = 0
			DISPLAY_BRIEF ( 3369 ) // "What the fuck are you doing? do you want fucked up again? Get back into the truck!"
			POINT_ARROW_AT ( arrow , k_m_3_armoured_truck_1 )
		ENDIF
	ENDIF 


	IF ( ( k_m_3_armoured_truck_1_created = 2 )
	AND ( k_m_3_all_generators_destroyed < 3 ) )
		IF ( IS_CAR_WRECKED ( k_m_3_armoured_truck_1 ) ) 
			SET k_m_3_armoured_truck_1_created = 3
			POINT_ARROW_AT ( arrow , k_m_3_pickup_group_1_leader )
			DISPLAY_BRIEF ( 3370 ) // "How did you manage to destroy an armoured truck! Now you have no protection! Finish the job!"
		ENDIF
	ENDIF

	IF ( ( ( k_m_3_armoured_truck_1_created = 2 )
	AND ( k_m_3_all_generators_destroyed < 3 ) )
	AND ( LOCATE_CHARACTER_ANY_MEANS ( shaft , 62.0 , 249.0 , 2.0 , 2.0 , 2.0  ) ) )
		SET k_m_3_armoured_truck_1_created = 3
		POINT_ARROW_AT ( arrow , k_m_3_pickup_group_1_leader )
		DISPLAY_BRIEF ( 3371 ) // "Ok go and see if my people are all right!"
	ENDIF


	// check for player seeing group with the generators still intact


	IF ( ( ( LOCATE_ANOTHER_CHARACTER_ANY_MEANS ( shaft , k_m_3_pickup_group_1_leader , 3.0 , 3.0  ) )
	AND	( k_m_3_all_generators_destroyed < 3 ) )
	AND ( k_m_3_pickup_group_1_leader_onscreen_gens_not_dead = 0 ) )
		DISPLAY_BRIEF ( 3372 ) // "We're not going anywhere until you get rid of the defences!"
		SET k_m_3_pickup_group_1_leader_onscreen_gens_not_dead = 1
	ENDIF


	IF ( (  k_m_3_pickup_group_1_leader_onscreen_gens_not_dead = 1 )
	AND ( NOT ( IS_ITEM_ONSCREEN ( k_m_3_pickup_group_1_leader ) ) ) )
		SET k_m_3_pickup_group_1_leader_onscreen_gens_not_dead = 0
	ENDIF


	  	// checks for in car and onscreen, stores current car info
			
	IF ( ( ( ( k_m_3_all_generators_destroyed = 3 )
	AND ( IS_CHARACTER_IN_MODEL ( shaft , krsnabus ) ) ) 
	AND ( LOCATE_ANOTHER_CHARACTER_BY_CAR ( shaft , k_m_3_pickup_group_1_leader , 3.0 , 3.0  ) ) )
	AND ( k_m_3_send_pickup_group_1_in_bus = 0 ) )
		STORE_CAR_CHARACTER_IS_IN ( shaft , k_m_3_group_1_bus )
		ORDER_CHAR_TO_BACKDOOR ( k_m_3_pickup_group_1_leader , k_m_3_group_1_bus )
		SET k_m_3_send_pickup_group_1_in_bus = 1
		DISPLAY_BRIEF_NOW ( 3373 ) // "Everyone on the bus, he is here to help us!"
	ELSE
		
		// tells player to steal a car with bigger capacity

		IF ( ( ( ( ( k_m_3_all_generators_destroyed = 3 )
		AND ( IS_CHARACTER_IN_ANY_CAR ( shaft ) ) )
		AND ( LOCATE_ANOTHER_CHARACTER_BY_CAR ( shaft , k_m_3_pickup_group_1_leader , 3.0 , 3.0  ) ) )
		AND ( k_m_3_group_1_leader_onscreen_car = 0 ) )
		AND ( k_m_3_send_pickup_group_1_in_bus = 0 ) ) 
			DISPLAY_BRIEF_NOW ( 3374 ) // "How do we know we can trust you? We will only travel in a Krishna bus!"
			SET k_m_3_group_1_leader_onscreen_car = 1
		ENDIF
	ENDIF

	IF ( ( ( k_m_3_all_generators_destroyed = 3 )
	AND ( NOT ( IS_ITEM_ONSCREEN ( k_m_3_pickup_group_1_leader ) ) ) )
	AND ( k_m_3_group_1_leader_onscreen_car = 1 ) )
		SET k_m_3_group_1_leader_onscreen_car = 0
	ENDIF
	

	// tells player to steal a car and pick them up

	IF ( ( ( ( k_m_3_all_generators_destroyed = 3 )
	AND ( LOCATE_ANOTHER_CHARACTER_ON_FOOT ( shaft , k_m_3_pickup_group_1_leader , 2.0 , 2.0  ) ) ) 
	AND ( k_m_3_group_1_leader_onscreen_foot = 0 ) )
	AND ( k_m_3_send_pickup_group_1_in_bus = 0 ) )
		DISPLAY_BRIEF_NOW ( 3375 ) // "What are you going to do you foolish man? Carry us? Get a Krishna Bus!"
		SET k_m_3_group_1_leader_onscreen_foot = 1
	ENDIF


	IF ( ( ( k_m_3_all_generators_destroyed = 3 )
	AND ( NOT ( IS_ITEM_ONSCREEN ( k_m_3_pickup_group_1_leader ) ) ) )
	AND ( k_m_3_group_1_leader_onscreen_foot = 1 ) )
		SET k_m_3_group_1_leader_onscreen_foot = 0
	ENDIF


	IF ( ( ( ( k_m_3_send_pickup_group_1_in_bus = 1 ) 
	AND ( k_m_3_pickup_group_1_in_bus = 0 ) )
	AND ( IS_GROUP_IN_CAR ( k_m_3_pickup_group_1_leader ) ) )
	AND ( IS_CHAR_OBJECTIVE_PASSED ( k_m_3_pickup_group_1_leader ) ) )
		DISPLAY_BRIEF_NOW ( 3376 ) // "Wait until we are all on the bus!"	
		SET k_m_3_pickup_group_1_in_bus = 1
		SET k_m_3_send_pickup_group_2_in_bus = 1
		SET k_m_3_group_1_killed_on_bus = 1				
		KILL_ALL_PASSENGERS ( k_m_3_group_1_bus )
		ORDER_CHAR_TO_BACKDOOR ( k_m_3_pickup_group_2_leader , k_m_3_group_1_bus )
	ENDIF


	IF ( ( ( ( k_m_3_send_pickup_group_2_in_bus = 1 ) 
	AND ( k_m_3_pickup_group_2_in_bus = 0 ) )
	AND ( IS_GROUP_IN_CAR ( k_m_3_pickup_group_2_leader ) ) )
	AND ( IS_CHAR_OBJECTIVE_PASSED ( k_m_3_pickup_group_2_leader ) ) )
		DISPLAY_BRIEF_NOW ( 3377 ) // "Take us back to the temple, we need to see the boss!"	
		SET k_m_3_pickup_group_2_in_bus = 1
		SET k_m_3_pickup_group_in_bus_going_to_temple = 1
		SET k_m_3_group_2_killed_on_bus = 1
		KILL_ALL_PASSENGERS ( k_m_3_group_1_bus )
		UPDATE_DOOR_TARGET ( k_m_3_door_2 , k_m_3_group_1_bus )
		MAKE_DOOR_AUTOMATIC ( k_m_3_door_2 )
	ENDIF

	
	IF ( ( ( ( k_m_3_group_1_killed_on_bus = 0 )
	AND ( k_m_3_group_dead = 0 ) )
	AND ( HAS_CHARACTER_DIED ( k_m_3_pickup_group_1_leader ) ) )
	AND ( flag_failed_kris_med_phone1_2_m3 = 0 ) )
		SET k_m_3_group_dead = 1
