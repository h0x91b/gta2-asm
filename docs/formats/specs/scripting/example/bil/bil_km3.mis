		k_m_3_powerup_5 = CREATE_OBJ ( 60.0 , 235.5 , 2.0 ) 0 COLLECT_02 15 END // rocket launcher
		FORCE_CLEANUP ( k_m_3_powerup_1 )
		FORCE_CLEANUP ( k_m_3_powerup_5 )
