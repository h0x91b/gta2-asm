		#endif
		SET_CAR_BULLETPROOF ( k_m_3_armoured_truck_1 , on )
		SET_CAR_FLAMEPROOF ( k_m_3_armoured_truck_1 , on )
		SET_CAR_ROCKETPROOF ( k_m_3_armoured_truck_1 , on ) 
		POINT_ARROW_AT ( arrow , k_m_3_armoured_truck_1 )
		SET k_m_3_armoured_truck_1_created = 2
		SET_DEATHARREST_STATE ( shaft , ON )
	ENDIF
				
/*	
	// player dead check how many times

	IF ( ( HAS_CHARACTER_DIED ( shaft ) )
	AND ( k_m_3_player_dead = 1 ) )
