		DISPLAY_BRIEF ( 3380 ) // "You were supposed to save them from testing and now they are dead! You have failed me!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF


ENDWHILE

	

WHILE_EXEC ( k_m_3_in_bus_1_parked = 0 )


	// if player gets out of car points back at car and says to get back in
		
   	IF ( ( ( k_m_3_pickup_group_in_bus_going_to_temple = 1 )
   	AND ( k_m_3_player_in_group_1_bus = 1 ) )
	AND ( NOT ( IS_CHARACTER_IN_CAR ( shaft , k_m_3_group_1_bus ) ) ) )
		SET k_m_3_player_in_group_1_bus = 0
		DISPLAY_BRIEF ( 3379 ) // "Where are you going you can't just leave us here! Come back!"
		POINT_ARROW_AT ( arrow , k_m_3_group_1_bus )
	ENDIF
	
	
	// player is in bus with the two groups


	IF ( ( ( k_m_3_pickup_group_in_bus_going_to_temple = 1 )
	AND ( k_m_3_player_in_group_1_bus = 0 ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , k_m_3_group_1_bus ) ) )
		SET k_m_3_player_in_group_1_bus = 1
		DISPLAY_BRIEF ( 3378 ) // "What have you been doing? Take us to the temple!"
   		POINT_ARROW_AT ( arrow , 189.0 , 192.0 , 2.0 )
	ENDIF

	
	IF ( ( ( k_m_3_pickup_group_in_bus_going_to_temple = 1 )
	AND ( flag_failed_kris_med_phone1_2_m3 = 0 ) )
	AND ( IS_CAR_WRECKED ( k_m_3_group_1_bus ) ) )
		SET flag_failed_kris_med_phone1_2_m3 = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3380 ) // "You were supposed to save them from testing and now they are dead! You have failed me!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF


	// waits for player outside door, then parks the truck
	
	IF ( ( ( k_m_3_pickup_group_in_bus_going_to_temple = 1 )
	AND ( IS_CAR_IN_BLOCK ( k_m_3_group_1_bus , 189.0 , 193.0 , 2.0 , 2.0 , 2.0 ) )	)
//	AND ( LOCATE_CHARACTER_BY_CAR ( shaft , 189.0 , 193.0 , 2.0 , 2.0 , 2.0 ) ) )
	AND ( k_m_3_in_bus_1_parking = 0 ) )
//	AND ( IS_CHARACTER_IN_CAR ( shaft , k_m_3_group_1_bus ) ) )
		PARK ( k_m_3_group_1_bus , k_m_3_door_2 )
		SET k_m_3_in_bus_1_parking = 1
	ENDIF	


// waits for truck to finish parking, then passes mission


	IF ( ( k_m_3_in_bus_1_parking = 1 )
	AND ( HAS_PARK_FINISHED ( ) ) )
		SET flag_passed_kris_med_phone1_2_m3 = 1
		SET k_m_3_in_bus_1_parked = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3381 ) // "Well done my people are safe because of you, you have passed the mission!"
		++ counter_all_missions_passed
		DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
		ADD_SCORE ( shaft , 60000 )
		ADD_MULTIPLIER ( shaft , 1 ) 
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , 1 )
		CLEAR_WANTED_LEVEL ( shaft )
		IF ( flag_passed_kris_med_phone1_m1 = 1 )
			SET_PHONE_DEAD ( ph_kris_med_phone1 ) 
			DISABLE_THREAD_TRIGGER ( thr_kris_med_phone1_m1 )
		ENDIF
		IF ( flag_passed_kris_med_phone2_m1 = 1 )
			SET_PHONE_DEAD ( ph_kris_med_phone2 ) 
			DISABLE_THREAD_TRIGGER ( thr_kris_med_phone2_m1 )
		ENDIF
		RETURN
	ENDIF

		



ENDWHILE



