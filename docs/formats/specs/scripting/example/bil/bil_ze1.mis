		IF ( ( ( ( IS_CHARACTER_IN_ANY_CAR ( shaft ) ) 
		AND ( LOCATE_ANOTHER_CHARACTER_BY_CAR ( shaft , z_e_1_hot_dog_man_1 , 2.0 , 2.0 ) ) )
		AND ( z_e_1_in_wrong_car_at_ped_1 = 0 ) )
