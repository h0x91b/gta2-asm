	SET_CHAR_THREAT_SEARCH ( r_m_3_tank_driver_3 , no_threats )
	SET_CHAR_THREAT_REACTION ( r_m_3_tank_driver_3 , no_reaction )
 	ADD_CHAR_TO_GANG ( r_m_3_tank_driver_3 , zaibgang )
 	SET_CHAR_DRIVE_AGGRESSION ( r_m_3_tank_driver_3 , on )
