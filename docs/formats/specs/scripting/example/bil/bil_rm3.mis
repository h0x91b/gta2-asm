	CHANGE_CAR_LOCK ( r_m_3_target_car_1 , locked )
  	SET_CAR_BULLETPROOF ( r_m_3_target_car_1 , on )
 	SET_CAR_FLAMEPROOF ( r_m_3_target_car_1 , on )
  	SET_CAR_NO_COLLIDE ( r_m_3_target_car_1 )
	
	#ifdef PC
	
	// tank1

	r_m_3_tank_1 = CREATE_CAR ( 218.5 , 53.5 , 3.0 ) -1 270 tank END
  	SET_CAR_BULLETPROOF ( r_m_3_tank_1 , on )
	SET_CAR_BULLETPROOF ( r_m_3_tank_1 , on )
 	CHANGE_CAR_LOCK ( r_m_3_tank_1 , locked )
 	r_m_3_tank_driver_1 = CREATE_CHAR_INSIDE_CAR ( r_m_3_tank_1 ) 8 tank_driver END
	SET_CHAR_THREAT_SEARCH ( r_m_3_tank_driver_1 , no_threats )
	SET_CHAR_THREAT_REACTION ( r_m_3_tank_driver_1 , no_reaction )
 	ADD_CHAR_TO_GANG ( r_m_3_tank_driver_1 , zaibgang )
 	SET_CHAR_DRIVE_AGGRESSION ( r_m_3_tank_driver_1 , on )
 	SET_CHAR_MAX_DRIVESPEED ( r_m_3_tank_driver_1 , 0.02 )
  	SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_1 , goto_area_in_car , 143.0 , 53.5 , 2.0 )

  	// tank1 guard1
  	
  	r_m_3_tank_1_guard_1 = CREATE_CHAR ( 219.5 , 54.5 , 3.0 ) 8 270 criminal END
