  	SET_CAR_NO_COLLIDE ( r_m_3_target_car_3 )
	
	// tank3

	r_m_3_tank_3 = CREATE_CAR ( 223.5 , 87.5 , 2.0 ) -1 180 tank END
  	SET_CAR_BULLETPROOF ( r_m_3_tank_3 , on )
	SET_CAR_BULLETPROOF ( r_m_3_tank_3 , on )
 	CHANGE_CAR_LOCK ( r_m_3_tank_3 , locked )
