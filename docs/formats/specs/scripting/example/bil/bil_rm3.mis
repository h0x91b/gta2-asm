	ENDIF


	IF ( ( r_m_3_tank_3_destroyed = 0 )
	AND ( IS_CAR_WRECKED ( r_m_3_tank_3 ) ) )
		++ r_m_3_all_tanks_wrecked
		REMOVE_ARROW ( arrow_3 )
		SET r_m_3_tank_3_destroyed = 1
//		SET_CHAR_OBJECTIVE ( r_m_3_tank_3_guard_1 , kill_char_on_foot , shaft )
//		SET_CHAR_OBJECTIVE ( r_m_3_tank_3_guard_2 , kill_char_on_foot , shaft )
		IF ( r_m_3_all_tanks_wrecked = 1 )
			DISPLAY_BRIEF_NOW ( 3648 ) //"Well done, you destroyed one of the tanks!"
			ELSE
				
			IF ( r_m_3_all_tanks_wrecked = 2 )
				DISPLAY_BRIEF_NOW ( 3649 ) //"Good work, you've fucked up two of the tanks! One more to go!"
			ENDIF
		ENDIF
	ENDIF

	#ifdef PC
	IF ( ( ( r_m_3_tank_1_destroyed = 0 )
	AND ( IS_CAR_IN_BLOCK ( r_m_3_tank_1 , 143.0 , 53.5 , 2.0 , 1.5 , 1.5 ) ) )
	AND ( r_m_3_tank_1_in_location = 0 ) )
		SET r_m_3_tank_1_in_location = 1
		SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_1 , fire_at_object_from_vehicle  , r_m_3_invisible_obj_tank_to_shoot_at )
		DISPLAY_BRIEF_NOW ( 3650 ) //"Good work, you've fucked up two of the tanks! One more to go!"
	ENDIF
	#endif

	IF ( ( ( r_m_3_tank_2_destroyed = 0 )
	AND ( IS_CAR_IN_BLOCK ( r_m_3_tank_2 , 145.0 , 53.5 , 2.0 , 1.5 , 1.5 ) ) )
	AND ( r_m_3_tank_2_in_location = 0 ) )
		SET r_m_3_tank_2_in_location = 1
		SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_2 , fire_at_object_from_vehicle  , r_m_3_invisible_obj_tank_to_shoot_at )
		DISPLAY_BRIEF_NOW ( 3650 ) //"Good work, you've fucked up two of the tanks! One more to go!"
	ENDIF

	IF ( ( ( r_m_3_tank_3_destroyed = 0 )
	AND ( IS_CAR_IN_BLOCK ( r_m_3_tank_3 , 147.0 , 53.5 , 2.0 , 1.5 , 1.5 ) ) )
	AND ( r_m_3_tank_3_in_location = 0 ) )
		SET r_m_3_tank_3_in_location = 1
		SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_3 , fire_at_object_from_vehicle  , r_m_3_invisible_obj_tank_to_shoot_at )
		DISPLAY_BRIEF_NOW ( 3650 ) //"Good work, you've fucked up two of the tanks! One more to go!"
	ENDIF
	
 				
ENDWHILE
	
			  
	
		
//checks to see if the player has passed the mission	 	

#ifdef PC	
IF ( ( r_m_3_all_tanks_wrecked = 3 )
#endif
#ifdef PSX	
IF ( ( r_m_3_all_tanks_wrecked = 2 )
#endif
AND ( flag_passed_russ_med_phone1_2_m3 = 0 ) )
	SET flag_passed_russ_med_phone1_2_m3 = 1
	CLEAR_ALL_BRIEFS ( )
	DISPLAY_BRIEF ( 3642 )  //"Well Done! Mission Complete!"
	++ counter_all_missions_passed
	DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
	ADD_SCORE ( shaft , 60000 )
	ADD_MULTIPLIER ( shaft , 1 ) 
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( russgang , shaft , 1 )
	CLEAR_WANTED_LEVEL ( shaft )
 	IF ( flag_passed_russ_med_phone1_m1 = 1 )
		SET_PHONE_DEAD ( ph_russ_med_phone1 ) 
		DISABLE_THREAD_TRIGGER ( thr_russ_med_phone1_m1 )
	ENDIF
	IF ( flag_passed_russ_med_phone2_m1 = 1 )
		SET_PHONE_DEAD ( ph_russ_med_phone2 ) 
		DISABLE_THREAD_TRIGGER ( thr_russ_med_phone2_m1 )
	ENDIF
	RETURN
ENDIF



//------------------------------------------------------------------------------------------
//------------------------------------------------------------------------------------------
//Mission cleanup

clean_up_russ_med_phone1_2_m3:

	REMOVE_ARROW ( arrow )
	REMOVE_ARROW ( arrow_2 )
	REMOVE_ARROW ( arrow_3 )
	REMOVE_ARROW ( arrow_4 )
	SET_CAR_DENSITY ( cityinfo , 600 ) 

	SET_CAR_DENSITY ( m01 , 400 ) 

	SET_CAR_DENSITY ( m02 , 400 ) 

	SET_CAR_DENSITY ( m03 , 400 ) 

	SET_CAR_DENSITY ( m04 , 400 ) 

	SET_CAR_DENSITY ( m05 , 400 ) 

	SET_CAR_DENSITY ( m06 , 400 ) 

	SET_CAR_DENSITY ( m07 , 400 ) 

	SET_CAR_DENSITY ( m08 , 400 ) 

	SET_CAR_DENSITY ( m09 , 400 ) 

	SET_CAR_DENSITY ( m10 , 400 ) 

	SET_CAR_DENSITY ( m11 , 400 ) 

	SET_CAR_DENSITY ( m12 , 400 ) 

	SET_CAR_DENSITY ( m13 , 400 ) 

	SET_CAR_DENSITY ( m14 , 400 ) 

	SET_CAR_DENSITY ( m15 , 400 ) 
	
	IF ( flag_passed_russ_med_phone1_2_m3 = 1 )
		++ flag_russ_missions_passed
		++ flag_all_missions_passed
		IF ( flag_russ_missions_passed = 7 )
			DISPLAY_BRIEF ( 3673 ) // "Good work that should stop them building into our community"
			DISPLAY_MESSAGE ( 3672 ) // you have PASSED the mission!"
		ENDIF
	ENDIF

	IF ( flag_failed_russ_med_phone1_2_m3 = 1 )
		++ flag_russ_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( russgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
	ENDIF 

	IF ( CHECK_DEATHARREST_EXECUTED ( ) )
		++ flag_russ_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( russgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
	ENDIF
		
	MISSION_HAS_FINISHED ( )

	SET flag_on_mission = 0
	SET flag_on_russ_mission = 0
	
	RETURN


MISSIONSTART

	GOSUB russ_med_phone1_2_m3:

	GOSUB clean_up_russ_med_phone1_2_m3:

MISSIONEND



 

