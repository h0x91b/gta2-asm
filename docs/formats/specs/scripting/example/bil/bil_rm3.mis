  	SET_CHAR_OBJECTIVE ( r_m_3_tank_3_guard_2 , follow_car_on_foot_with_offset , r_m_3_tank_3 , 270 , 1.0 )
  	
	#ifdef PC
	POINT_ARROW_AT ( arrow , r_m_3_tank_1 )
	#endif
	POINT_ARROW_AT ( arrow_2 , r_m_3_tank_2 )
	POINT_ARROW_AT ( arrow_3 , r_m_3_tank_3 )

	SET_CAR_DENSITY ( m01 , 100 ) 

	SET_CAR_DENSITY ( m02 , 100 ) 

	SET_CAR_DENSITY ( m03 , 100 ) 

	SET_CAR_DENSITY ( m04 , 100 ) 

	SET_CAR_DENSITY ( m05 , 100 ) 

	SET_CAR_DENSITY ( m06 , 100 ) 

	SET_CAR_DENSITY ( m07 , 100 ) 

	SET_CAR_DENSITY ( m08 , 100 ) 

	SET_CAR_DENSITY ( m09 , 100 ) 

	SET_CAR_DENSITY ( m10 , 100 ) 

	SET_CAR_DENSITY ( m11 , 100 ) 

	SET_CAR_DENSITY ( m12 , 100 ) 

	SET_CAR_DENSITY ( m13 , 100 ) 

	SET_CAR_DENSITY ( m14 , 100 ) 

	SET_CAR_DENSITY ( m15 , 100 ) 

	SET_CAR_DENSITY ( cityinfo , 100 ) 
 			
ENDEXEC


			
	
		
  			
//waits for tanks to get to location
		  
#ifdef PC		  
WHILE_EXEC ( r_m_3_all_tanks_wrecked < 3 )
#endif
#ifdef PSX		  
WHILE_EXEC ( r_m_3_all_tanks_wrecked < 2 )
#endif


	#ifdef PC
	IF ( ( ( r_m_3_tank_1_destroyed = 0 )
	AND ( r_m_3_tank_1_on_screen = 0 ) )
	AND ( IS_ITEM_ACCURATELY_ONSCREEN ( r_m_3_tank_1 ) ) )
		MAKE_CHAR_DO_NOTHING ( r_m_3_tank_driver_1 ) 
		SET_CHAR_OCCUPATION ( r_m_3_tank_driver_1 , road_block_tank_man )
//		SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_1 , no_obj )
		MAKE_CHAR_DO_NOTHING ( r_m_3_tank_driver_1 )
		SET r_m_3_tank_1_on_screen = 1
		IF ( r_m_3_tank_1_on_screen_brief = 0 )
			DISPLAY_BRIEF_NOW ( 3645 )  //"Are you mad? Have you noticed the vehicle that I'm driving? DIE!" 
			SET r_m_3_tank_1_on_screen_brief = 1
		ENDIF
	ENDIF


	IF ( ( ( r_m_3_tank_1_destroyed = 0 )
	AND ( r_m_3_tank_1_on_screen = 1 ) )
	AND ( NOT ( IS_ITEM_ACCURATELY_ONSCREEN ( r_m_3_tank_1 ) ) ) )
		SET r_m_3_tank_1_on_screen = 0 
		SET_CHAR_OCCUPATION ( r_m_3_tank_driver_1 , tank_driver )
		SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_1 , goto_area_in_car , 145.0 , 54.0 , 2.0 )		
	ENDIF
	#endif
	
	
	IF ( ( ( r_m_3_tank_2_destroyed = 0 )
	AND ( r_m_3_tank_2_on_screen = 0 ) )
	AND ( IS_ITEM_ACCURATELY_ONSCREEN ( r_m_3_tank_2 ) ) )
		MAKE_CHAR_DO_NOTHING ( r_m_3_tank_driver_2 ) 
		SET_CHAR_OCCUPATION ( r_m_3_tank_driver_2 , road_block_tank_man )
//		SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_2 , no_obj )
		MAKE_CHAR_DO_NOTHING ( r_m_3_tank_driver_2 )
