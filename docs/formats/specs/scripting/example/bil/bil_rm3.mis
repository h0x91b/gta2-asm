		SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_3 , goto_area_in_car , 145.0 , 54.0 , 2.0 )		
	ENDIF

	
	IF ( ( IS_CAR_WRECKED ( r_m_3_target_car_1 ) )
	AND ( r_m_3_target_car_1_wrecked = 0 ) )
		SET r_m_3_target_car_1_wrecked = 1
  	ENDIF


	IF ( ( ( r_m_3_target_car_1_wrecked = 1 ) 
	AND ( r_m_3_target_car_1_wrecked_expl_1 = 0 ) )
	AND ( NOT ( DELAY ( 10 ) ) ) )
		EXPLODE_NO_RING ( 144.3 , 46.8 , 3.0 ) 
		SET r_m_3_target_car_1_wrecked_expl_1 = 1
	ENDIF
	
	
	IF ( ( ( r_m_3_target_car_1_wrecked = 1 ) 
	AND ( r_m_3_target_car_1_wrecked_expl_1 = 1 ) )
	AND ( NOT ( DELAY ( 10 ) ) ) )
		EXPLODE ( 142.5 , 46.5 , 2.0 )
		SET r_m_3_target_car_1_wrecked_expl_1 = 2
	ENDIF
	
	
	IF ( ( ( r_m_3_target_car_1_wrecked = 1 ) 
	AND ( r_m_3_target_car_1_wrecked_expl_1 = 2 ) )
	AND ( NOT ( DELAY ( 10 ) ) ) )
		EXPLODE_NO_RING ( 142.8 , 46.3 , 3.0 ) 
