	ENDIF
		
 	
	#ifdef PC
	IF ( ( r_m_3_tank_1_destroyed = 0 )
	AND ( IS_CAR_WRECKED ( r_m_3_tank_1 ) ) )
		++ r_m_3_all_tanks_wrecked
		REMOVE_ARROW ( arrow )
		SET r_m_3_tank_1_destroyed = 1
