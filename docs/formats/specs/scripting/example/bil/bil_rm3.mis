	SET_CHAR_THREAT_SEARCH ( r_m_3_tank_3_guard_2 , area_player_only )
	SET_CHAR_THREAT_REACTION ( r_m_3_tank_3_guard_2 , react_as_normal )
  	GIVE_WEAPON ( r_m_3_tank_3_guard_2 , machine_gun )
