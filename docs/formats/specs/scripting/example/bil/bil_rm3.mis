			SET r_m_3_tank_2_on_screen_brief = 1
		ENDIF
	ENDIF


	IF ( ( ( r_m_3_tank_2_destroyed = 0 )
	AND ( r_m_3_tank_2_on_screen = 1 ) )
	AND ( NOT ( IS_ITEM_ACCURATELY_ONSCREEN ( r_m_3_tank_2 ) ) ) )
		SET r_m_3_tank_2_on_screen = 0 
		SET_CHAR_OCCUPATION ( r_m_3_tank_driver_2 , tank_driver )
		SET_CHAR_OBJECTIVE ( r_m_3_tank_driver_2 , goto_area_in_car , 145.0 , 54.0 , 2.0 )		
	ENDIF


	IF ( ( ( r_m_3_tank_3_destroyed = 0 )
	AND ( r_m_3_tank_3_on_screen = 0 ) )
	AND ( IS_ITEM_ACCURATELY_ONSCREEN ( r_m_3_tank_3 ) ) )
