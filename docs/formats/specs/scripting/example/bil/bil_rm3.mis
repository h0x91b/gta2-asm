russ_med_phone1_2_m3:

SET flag_failed_russ_med_phone1_2_m3 = 0

		
EXEC
	
	SET flag_on_mission = 1
	SET flag_on_russ_mission = 1
	DISPLAY_MESSAGE ( 3858 ) // you have PASSED the mission!"
  	#ifdef PC
  	DISPLAY_BRIEF ( 3640 )  //"There are tanks on the way to destroy our base you must stop them at all costs!"
	#endif
	#ifdef PSX
  	DISPLAY_BRIEF ( 3651 )  //"There are tanks on the way to destroy our base you must stop them at all costs!"
	#endif
	DISPLAY_BRIEF ( 3641 )  //"There are tanks on the way to destroy our base you must stop them at all costs!"
	
	r_m_3_powerup_1 = CREATE_OBJ ( 197.5 , 15.5 , 2.0 ) 0 collect_02 15 END
	r_m_3_powerup_2 = CREATE_OBJ ( 198.5 , 15.5 , 2.0 ) 0 collect_03 20 END
	
	FORCE_CLEANUP ( r_m_3_powerup_1 )
	FORCE_CLEANUP ( r_m_3_powerup_2 )

	// tank1 target car
	
	r_m_3_invisible_obj_tank_to_shoot_at = CREATE_OBJ ( 144.0 , 45.5 , 2.0 ) 0 invisible_target END
