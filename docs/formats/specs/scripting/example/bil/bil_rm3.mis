	SET_CHAR_THREAT_REACTION ( r_m_3_tank_1_guard_1 , react_as_normal )
	GIVE_WEAPON ( r_m_3_tank_1_guard_1 , machine_gun )
	ADD_CHAR_TO_GANG ( r_m_3_tank_1_guard_1 , zaibgang )
