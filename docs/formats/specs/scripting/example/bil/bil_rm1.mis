// objects for Russian med phone1 mission1		
	
COUNTER r_m_1_copcars_destroyed = 0
COUNTER r_m_1_copcar_destroyed_1 = 0
COUNTER r_m_1_copcar_destroyed_2 = 0
COUNTER r_m_1_copcar_destroyed_3 = 0
COUNTER r_m_1_firetrucks_destroyed = 0
COUNTER r_m_1_firetruck_destroyed_1 = 0
COUNTER r_m_1_firetruck_destroyed_2 = 0
COUNTER r_m_1_firetruck_destroyed_3 = 0
COUNTER r_m_1_ambulances_destroyed = 0
COUNTER r_m_1_ambulance_destroyed_1 = 0
COUNTER r_m_1_ambulance_destroyed_2 = 0
COUNTER r_m_1_ambulance_destroyed_3 = 0
COUNTER r_m_1_copcar_half_done = 0

COUNTER r_m_1_timer = 8999
//COUNTER r_m_1_timer = 100

OBJ_DATA r_m_1_powerup_1
OBJ_DATA r_m_1_powerup_2

TIMER_DATA r_m_1_timer_data

FORWARD clean_up_russ_med_phone1_m1:





//------------------------------------------------------------------------------------------
//------------------------------------------------------------------------------------------


		
// starts Russian easy phone1 mission1
					

russ_med_phone1_m1:

SET flag_failed_russ_med_phone1_m1 = 0

//DISABLE_THREAD_TRIGGER ( thr_russ_med_phone1_m1 ) 
DISPLAY_MESSAGE ( 3856 ) // you have PASSED the mission!"
#ifdef PC
DISPLAY_BRIEF ( 3560 ) // "go pick up a couple of my men"
#endif
#ifdef PSX
DISPLAY_BRIEF ( 3577 ) // "go pick up a couple of my men"
#endif
SET flag_on_mission	= 1
SET flag_on_russ_mission = 1
DISPLAY_TIMER ( r_m_1_timer_data , 300 )
r_m_1_powerup_1 = CREATE_OBJ ( 197.5 , 15.5 , 2.0 ) 0 COLLECT_02 15 END 
r_m_1_powerup_2 = CREATE_OBJ ( 198.5 , 15.5 , 2.0 ) 0 COLLECT_04 15 END
FORCE_CLEANUP ( r_m_1_powerup_1 )
FORCE_CLEANUP ( r_m_1_powerup_2 )

SETUP_MODELCHECK_DESTROY ( copcar ) 

#ifdef PC
WHILE_EXEC ( r_m_1_copcars_destroyed < 2 )  
	
	IF ( HAS_MODELCHECK_HAPPENED ( ) )
		++ r_m_1_copcars_destroyed 
	ENDIF

	IF ( ( r_m_1_copcars_destroyed = 1 )
	AND ( r_m_1_copcar_destroyed_1 = 0 ) )
		SET r_m_1_copcar_destroyed_1 = 1 
		DISPLAY_BRIEF_NOW ( 3561 ) // you failed to kill all the cops!!!!
	ENDIF
	
	IF ( ( ( r_m_1_timer = 0 )
	AND ( r_m_1_copcars_destroyed < 2 ) )
	AND ( flag_failed_russ_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3574 ) // "you were told to stay alive, you have failed me!"
		SET flag_failed_russ_med_phone1_m1 = 1
		CLEAR_TIMER ( r_m_1_timer_data )
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF
	   

-- r_m_1_timer 

ENDWHILE

IF ( ( r_m_1_copcars_destroyed = 2 )
AND ( r_m_1_copcar_half_done = 0 ) )
	SETUP_MODELCHECK_DESTROY ( swatvan ) 
	DISPLAY_BRIEF_NOW ( 3565 ) // "you have stayed alive and passed my test. Well done"
	SET r_m_1_copcar_half_done = 1 
ENDIF

WHILE_EXEC ( ( r_m_1_firetrucks_destroyed < 1 ) 
AND ( r_m_1_copcar_half_done = 1 ) ) 
	
	IF ( HAS_MODELCHECK_HAPPENED ( ) )
		++ r_m_1_firetrucks_destroyed 
	ENDIF
/*
	IF ( ( r_m_1_firetrucks_destroyed = 1 )
	AND ( r_m_1_firetruck_destroyed_1 = 0 ) )
		SET r_m_1_firetruck_destroyed_1 = 1 
		DISPLAY_BRIEF_NOW ( 3566 ) // you failed to kill all the cops!!!!
	ENDIF
*/	
	IF ( ( ( r_m_1_timer = 0 )
	AND ( r_m_1_firetrucks_destroyed < 1 ) )
	AND ( flag_failed_russ_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3575 ) // "you were told to stay alive, you have failed me!"
		SET flag_failed_russ_med_phone1_m1 = 1
		CLEAR_TIMER ( r_m_1_timer_data )
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF
	   

-- r_m_1_timer 

ENDWHILE


IF ( ( r_m_1_firetrucks_destroyed = 1 )
AND ( r_m_1_copcar_half_done = 1 ) )
	SETUP_MODELCHECK_DESTROY ( edselfbi ) 
	DISPLAY_BRIEF_NOW ( 3569 ) // "you have stayed alive and passed my test. Well done"
	SET r_m_1_copcar_half_done = 2 
ENDIF

WHILE_EXEC ( ( r_m_1_ambulances_destroyed < 2 ) 
AND ( r_m_1_copcar_half_done = 2 ) ) 
	
	IF ( HAS_MODELCHECK_HAPPENED ( ) )
		++ r_m_1_ambulances_destroyed 
	ENDIF

	IF ( ( r_m_1_ambulances_destroyed = 1 )
	AND ( r_m_1_ambulance_destroyed_1 = 0 ) )
		SET r_m_1_ambulance_destroyed_1 = 1 
		DISPLAY_BRIEF_NOW ( 3570 ) // you failed to kill all the cops!!!!
	ENDIF
	
	IF ( ( ( r_m_1_timer = 0 )
	AND ( r_m_1_ambulances_destroyed < 2 ) )
	AND ( flag_failed_russ_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3576 ) // "you were told to stay alive, you have failed me!"
		SET flag_failed_russ_med_phone1_m1 = 1
		CLEAR_TIMER ( r_m_1_timer_data )
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF


-- r_m_1_timer 

ENDWHILE


IF ( ( ( ( ( r_m_1_firetrucks_destroyed >= 1 )
AND ( r_m_1_copcars_destroyed >= 2 ) )
AND ( r_m_1_ambulances_destroyed >= 2 ) )
AND ( flag_failed_russ_med_phone1_m1 = 0 ) )
AND ( flag_passed_russ_med_phone1_m1 = 0 ) )
	CLEAR_ALL_BRIEFS ( )
	DISPLAY_BRIEF ( 3573 ) // "you have stayed alive and passed my test. Well done"
	SET flag_passed_russ_med_phone1_m1 = 1
	CLEAR_TIMER ( r_m_1_timer_data )
	++ counter_all_missions_passed
	DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
	ADD_SCORE ( shaft , 60000 )
	ADD_MULTIPLIER ( shaft , 1 ) 
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( russgang , shaft , 1 )
	CLEAR_WANTED_LEVEL ( shaft )
	IF ( flag_passed_russ_med_phone1_2_m3 = 1 )
		SET_PHONE_DEAD ( ph_russ_med_phone1 ) 
		DISABLE_THREAD_TRIGGER ( thr_russ_med_phone1_m1 )
	ENDIF
	RETURN
ENDIF
#endif






#ifdef PSX
