		#ifdef PC
			k_e_1_dejected_mumble = CREATE_SOUND ( 210.0 , 81.5 , 6.0 ) detected_mumble play_instant END
		#endif
	ENDIF


	IF ( ( k_e_1_locksmith_on_screen = 2 ) 
	AND ( NOT ( DELAY ( 100 ) ) ) ) 
		SET k_e_1_locksmith_on_screen = 1
		#ifdef PC
			k_e_1_dejected_mumble = CREATE_SOUND ( 210.0 , 81.5 , 6.0 ) detected_mumble play_instant END
		#endif
