		#endif
	ENDIF


ENDWHILE											 


DELAY ( 60 )
DISPLAY_BRIEF_NOW ( 3170 ) // "You took your time with that door, now get into the yard! I want you to take out the top man. They can't do anything without his money!"
POINT_ARROW_AT ( arrow , k_e_1_zaib_leader )



WHILE_EXEC ( k_e_1_truck_and_leader_dead = 0 )


	IF ( ( HAS_CHARACTER_DIED ( k_e_1_zaib_leader ) )
	AND ( k_e_1_zaib_leader_dead = 0 ) )
		
		IF ( IS_CAR_WRECKED ( k_e_1_truck_with_trailer_1 ) ) 
			SET k_e_1_truck_and_leader_dead = 1
			CLEAR_ALL_BRIEFS ( )
			DISPLAY_BRIEF_NOW ( 3183 ) // "Well done, feel no guilt he was a non beleiver! We have crippled this site!"
		ENDIF
		
		IF ( NOT ( IS_CAR_WRECKED ( k_e_1_truck_with_trailer_1 ) ) )
			SET k_e_1_zaib_leader_dead = 1
			SET k_e_1_zaib_leader_dead_not_truck = 1
			DISPLAY_BRIEF_NOW ( 3171 ) // "Well done, feel no guilt he was a non beleiver! Take out the truck as well, just to make sure we cripple this site!"
			POINT_ARROW_AT ( arrow , k_e_1_truck_with_trailer_1 )
		ENDIF
	ENDIF


	IF ( ( IS_CAR_WRECKED ( k_e_1_truck_with_trailer_1 ) )
	AND ( k_e_1_zaib_leader_dead_not_truck = 1 ) ) 
		SET k_e_1_truck_and_leader_dead = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF_NOW ( 3172 ) // "Good work, that should cost them a pretty penny!!"
	ENDIF

	
	IF ( ( IS_CAR_WRECKED ( k_e_1_truck_with_trailer_1 ) )
	AND ( k_e_1_zaib_leader_dead_not_truck = 0 ) ) 
		SET k_e_1_zaib_leader_dead_not_truck = 2
		DISPLAY_BRIEF_NOW ( 3184 ) // "Nice shooting! I was going to tell you to take out the truck, that should cost them a pretty penny!"
	ENDIF

	
 	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( k_e_1_guard_1 ) ) 
   	AND ( k_e_1_guard_1_spotted_player = 0 ) )
		SET k_e_1_guard_1_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3174 ) // "Who the fuck are you! Get off of the site!"	 
	ENDIF
	
							  
	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( k_e_1_guard_2 ) ) 
   	AND ( k_e_1_guard_2_spotted_player = 0 ) )
		SET k_e_1_guard_2_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3175 ) // "This is private property, you fucking idiot!"	 
	ENDIF
	
	
	// if player is seen by guard1
	
