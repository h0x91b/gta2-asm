REMOVE_ARROW ( arrow )
DISPLAY_BRIEF_NOW ( 3168 ) // "Ok this won't take long, then i will be on my way!"
			

WHILE_EXEC ( k_e_1_door_1_open = 0 )

	
	IF ( ( HAS_CHARACTER_DIED ( k_e_1_locksmith ) )
	AND ( flag_failed_kris_easy_phone1_m1 = 0 ) )
		SET flag_failed_kris_easy_phone1_m1 = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3164 ) // "how do you expect to open the door when he's dead, dickhead!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF

 	
	IF ( ( IS_CHAR_OBJECTIVE_PASSED ( k_e_1_locksmith ) ) 
	AND ( k_e_1_locksmith_obj1_passed = 0 ) )
		SET k_e_1_locksmith_obj1_passed = 1
		SET_CHAR_OBJECTIVE ( k_e_1_locksmith , wait_on_foot )
		#ifdef PC
		k_e_1_tick = CREATE_SOUND ( 68.8 , 234.0 , 6.0 ) bomb_tick play_forever END
		FORCE_CLEANUP ( k_e_1_tick )
		#endif
   	ENDIF


	IF ( ( k_e_1_locksmith_obj1_passed = 1 ) 
	AND ( NOT ( DELAY ( 60 ) ) ) ) 
		OPEN_DOOR ( k_e_1_door_1 )
	   	DISPLAY_BRIEF_NOW ( 3169 ) // "Nice working with you, a word of advice though. Stop working for the Krishnas they will try to brainwash you into their ways!"
		SET k_e_1_locksmith_obj1_passed = 2
		SET k_e_1_door_1_open = 1
		MAKE_CHAR_DO_NOTHING ( k_e_1_locksmith )
