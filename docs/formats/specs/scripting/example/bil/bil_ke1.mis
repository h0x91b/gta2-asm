   	AND ( k_e_1_guard_3_spotted_player = 0 ) )
		SET k_e_1_guard_3_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3176 ) // "Can't you read the security signs? You will pay with your life!"	 
	ENDIF
	
	
	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( k_e_1_guard_4 ) ) 
   	AND ( k_e_1_guard_4_spotted_player = 0 ) )
		SET k_e_1_guard_4_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3177 ) // "You're a long way from home, and you're going home in a box!"	 
	ENDIF
	
	
	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( k_e_1_group_1_leader ) ) 
   	AND ( k_e_1_group_1_leader_spotted_player = 0 ) )
		SET k_e_1_group_1_leader_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3178 ) // "Stand your ground men, he can't take all of us together!"	 
	ENDIF
	
	
	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( k_e_1_group_2_leader ) ) 
   	AND ( k_e_1_group_2_leader_spotted_player = 0 ) )
		SET k_e_1_group_2_leader_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3179 ) // "Don't split up, keep your shape and he'll have no chance!"	 
	ENDIF
	
	// if player is seen by guard1
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( k_e_1_zaib_leader ) ) 
   	AND ( k_e_1_zaib_leader_spotted_player = 0 ) )
		SET k_e_1_zaib_leader_spotted_player = 1
		SET_CHAR_OBJECTIVE ( k_e_1_zaib_leader , flee_char_on_foot_always , shaft  )
		DISPLAY_BRIEF_NOW ( 3182 ) // "Don't split up, keep your shape and he'll have no chance!"	 
	ENDIF	


ENDWHILE


IF  ( ( k_e_1_truck_and_leader_dead = 1 )
AND ( flag_passed_kris_easy_phone1_m1 = 0 )	)
	DISPLAY_BRIEF ( 3180 ) // "Good work that should stop them building into our community"
	++ counter_all_missions_passed
	SET flag_passed_kris_easy_phone1_m1 = 1
	DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
	ADD_SCORE ( shaft , 40000 )
	ADD_MULTIPLIER ( shaft , 1 )
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , 1 ) 
	CLEAR_WANTED_LEVEL ( shaft )
	SET_PHONE_DEAD ( ph_kris_easy_phone1 ) 
	DISABLE_THREAD_TRIGGER ( thr_kris_easy_phone1_m1 ) 
	RETURN
ENDIF	 


//------------------------------------------------------------------------------------------
//------------------------------------------------------------------------------------------



// deletes all objects when Krishna easy phone1 mission1 is finished...
				
clean_up_kris_easy_phone1_m1: 
	
   	REMOVE_ARROW ( arrow )
	REMOVE_ARROW ( arrow_2 )
	REMOVE_ARROW ( arrow_3 )
	REMOVE_ARROW ( arrow_4 )
	OPEN_DOOR ( k_e_1_door_1 )

	IF ( flag_passed_kris_easy_phone1_m1 = 1 )
		++ flag_kris_missions_passed
		++ flag_all_missions_passed
		IF ( flag_kris_missions_passed = 7 )
			DISPLAY_BRIEF ( 3671 ) // "Good work that should stop them building into our community"
			DISPLAY_MESSAGE ( 3670 ) // you have PASSED the mission!"
		ENDIF
	ENDIF

	IF ( flag_failed_kris_easy_phone1_m1 = 1 )
		++ flag_kris_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
	ENDIF

	IF ( CHECK_DEATHARREST_EXECUTED ( ) )
		++ flag_kris_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
	ENDIF

	MISSION_HAS_FINISHED ( ) 
	
	SET flag_on_mission	= 0
	SET flag_on_kris_mission = 0
	
	RETURN



MISSIONSTART

	GOSUB kris_easy_phone1_m1:

	GOSUB clean_up_kris_easy_phone1_m1:

MISSIONEND 



