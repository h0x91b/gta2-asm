WHILE_EXEC ( k_e_1_locksmith_at_door = 0 )
   	
	
	IF ( ( LOCATE_CHARACTER_ON_FOOT ( shaft , 67.5 , 234.0 , 2.0 , 3.0 , 2.0  ) )
	AND ( NOT ( IS_CHARACTER_IN_ANY_CAR ( k_e_1_locksmith	) ) ) )
		SET k_e_1_locksmith_at_door = 1
	ENDIF

	
	IF ( ( HAS_CHARACTER_DIED ( k_e_1_locksmith ) )
	AND ( flag_failed_kris_easy_phone1_m1 = 0 ) )
		SET flag_failed_kris_easy_phone1_m1 = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3164 ) // "how do you expect to open the door when he's dead, dickhead!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF

	
	IF ( ( NOT ( IS_ITEM_ACCURATELY_ONSCREEN ( k_e_1_locksmith ) ) )
	AND ( k_e_1_locksmith_on_screen_2 = 0 ) )
		POINT_ARROW_AT ( arrow , k_e_1_locksmith )
		SET k_e_1_locksmith_on_screen_2 = 1
		DISPLAY_BRIEF_NOW ( 3185 ) // "Where the fuck is the guy? Have you taken off without him? Go and find him now!"
	ENDIF


	IF ( ( IS_ITEM_ACCURATELY_ONSCREEN ( k_e_1_locksmith ) )
	AND ( k_e_1_locksmith_on_screen_2 = 1 ) )
		POINT_ARROW_AT ( arrow , 67.0 , 234.0 , 2.0 )
		SET k_e_1_locksmith_on_screen_2 = 0
		DISPLAY_BRIEF_NOW ( 3186 ) // "Why did you leave me behind? I'm helping YOU! Take me to the locked door!"
	ENDIF
	

ENDWHILE


REMOVE_CHAR_FROM_GROUP ( shaft , k_e_1_locksmith )			
SET_CHAR_OBJECTIVE ( k_e_1_locksmith , goto_area_on_foot , 68.8 , 234.0 , 2.0 ) 
