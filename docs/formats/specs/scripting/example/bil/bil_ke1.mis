SET k_e_1_generator_1_created = 1


WHILE_EXEC ( k_e_1_generator_destroyed = 0 )
   	
	
	IF ( ( HAS_CHARACTER_DIED ( k_e_1_locksmith ) )
	AND ( flag_failed_kris_easy_phone1_m1 = 0 ) )
		SET flag_failed_kris_easy_phone1_m1 = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3164 ) // "how do you expect to open the door when he's dead, dickhead!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF


	IF ( ( LOCATE_ANOTHER_CHARACTER_ON_FOOT ( shaft , k_e_1_locksmith , 0.5 , 0.5  ) )
	AND ( k_e_1_locksmith_located = 0 ) ) 
		DISPLAY_BRIEF ( 3165 ) // "I'm not helping you, I hate your boss!"
		POINT_ARROW_AT ( arrow , k_e_1_generator_1 )
		SET k_e_1_locksmith_located = 1
		SET k_e_1_locksmith_located_2 = 1
		// put the locksmith throwing molotovs at the generator
	ENDIF

	
	IF ( CHECK_OBJ_MODEL ( k_e_1_generator_1 , powergen_dead ) )
		
		IF ( k_e_1_locksmith_located = 1 )
			SET k_e_1_generator_destroyed = 1
			#ifdef PC
			DELETE_ITEM ( k_e_1_generator_1_sound )
			#endif
			SET_CHAR_OBJECTIVE  ( k_e_1_locksmith , wait_on_foot )
		ENDIF

		IF ( k_e_1_locksmith_located = 0 )
			SET k_e_1_generator_destroyed = 2
			#ifdef PC
			DELETE_ITEM ( k_e_1_generator_1_sound )
			#endif
			SET_CHAR_OBJECTIVE  ( k_e_1_locksmith , wait_on_foot )
		ENDIF
	ENDIF

	
	IF ( ( IS_ITEM_ACCURATELY_ONSCREEN ( k_e_1_locksmith ) )
	AND ( k_e_1_locksmith_on_screen = 0 ) )
		SET_CHAR_OBJECTIVE  ( k_e_1_locksmith , destroy_object , k_e_1_invisible_object_1 )
		SET k_e_1_locksmith_on_screen = 1
	ENDIF

	
	IF ( ( k_e_1_locksmith_located_2 = 1 ) 
	AND ( NOT ( DELAY ( 100 ) ) ) ) 
		SET k_e_1_locksmith_located_2 = 2
		DISPLAY_BRIEF_NOW ( 3187 ) // "how do you expect to open the door when he's dead, dickhead!"
	ENDIF


	IF ( ( k_e_1_locksmith_located_2 = 2 ) 
	AND ( NOT ( DELAY ( 100 ) ) ) ) 
		SET k_e_1_locksmith_located_2 = 1
		DISPLAY_BRIEF_NOW ( 3188 ) // "how do you expect to open the door when he's dead, dickhead!"
	ENDIF

	
	IF ( ( k_e_1_locksmith_on_screen = 1 ) 
	AND ( NOT ( DELAY ( 100 ) ) ) ) 
