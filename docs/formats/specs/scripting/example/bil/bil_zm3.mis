// general mission objects

CAR_DATA z_m_3_russian_car

COUNTER z_m_3_in_krishna_gang_car = 0
COUNTER z_m_3_all_krishnas_dead = 0
COUNTER z_m_3_in_krishna_zone_4_first_time = 0
COUNTER z_m_3_in_krisgang_zone = 0
COUNTER z_m_3_in_krishna_gang_car_in_zone = 0

CAR_DATA z_m_3_krishna_car

COUNTER z_m_3_in_russian_gang_car = 0
COUNTER z_m_3_all_russians_dead = 0
COUNTER z_m_3_in_russian_zone_4_first_time = 0
COUNTER z_m_3_bonus_started = 0
COUNTER z_m_3_in_russgang_zone = 0
COUNTER z_m_3_in_russian_gang_car_in_zone = 0

ONSCREEN_COUNTER z_m_3_counter 
ONSCREEN_COUNTER z_m_3_counter_2 
  
COUNTER z_m_3_counter_total = 0 
COUNTER z_m_3_counter_2_total = 0
COUNTER z_m_3_constant_50 = 50
COUNTER z_m_3_constant_20 = 20

COUNTER z_m_3_total = 0			 
COUNTER z_m_3_total_2 = 0			 
			 
BONUS z_m_3_kris

BONUS z_m_3_russ


FORWARD	clean_up_zaib_med_phone1_2_m3:


// start of mission


zaib_med_phone1_2_m3:

SET flag_failed_zaib_med_phone1_2_m3 = 0

DISPLAY_MESSAGE ( 3847 ) // mission name


SET flag_on_mission = 1
SET flag_on_zaib_mission = 1




DISPLAY_BRIEF_NOW ( 3800 ) // We're going to mess with the SRS and Scientists minds. By the time you're finished, 
					   // they'll be ready to kill each other. Go and steal a Zaibatsu V-Type.
#ifdef PC

// part one - kill scientists

WHILE_EXEC ( z_m_3_all_krishnas_dead = 0 )


	IF ( ( IS_CHAR_IN_GANGZONE ( shaft , krisgang ) )
	AND ( z_m_3_in_krisgang_zone = 0 ) )
		SET z_m_3_in_krisgang_zone = 1
	ENDIF


	IF ( ( NOT ( IS_CHAR_IN_GANGZONE ( shaft , krisgang ) ) )
	AND ( z_m_3_in_krisgang_zone = 1 ) )
		SET z_m_3_in_krisgang_zone = 0
		IF ( z_m_3_in_krishna_zone_4_first_time = 1 )
			IF ( IS_CHARACTER_IN_MODEL ( shaft , buick ) )
				SET	z_m_3_in_russian_gang_car = 0
				SET z_m_3_in_russian_gang_car_in_zone = 1
			ENDIF
			IF ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , buick ) ) )
				SET	z_m_3_in_russian_gang_car = 1
				SET z_m_3_in_russian_gang_car_in_zone = 1
			ENDIF
		ENDIF
	ENDIF


	IF ( z_m_3_in_krisgang_zone = 0 )

		IF  ( ( IS_CHARACTER_IN_MODEL ( shaft , buick ) )
		AND ( z_m_3_in_russian_gang_car = 0 ) )
			POINT_ARROW_AT ( arrow , 234.5 , 193.5 , 2.0 )
			SET z_m_3_in_russian_gang_car = 1
			IF ( z_m_3_in_krishna_zone_4_first_time = 0 )
				DISPLAY_BRIEF_NOW ( 3801 ) // Alright, head down to the Scientist area and kill some Scientist scum!
			ELSE
				DISPLAY_BRIEF_NOW ( 3804 ) // Alright, head down to the Scientist area and kill some Scientist scum!
			ENDIF
		ENDIF


		IF  ( ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , buick ) ) )
   		AND ( z_m_3_in_russian_gang_car = 1 ) )
			SET z_m_3_in_russian_gang_car = 0
			REMOVE_ARROW ( arrow )
			IF ( z_m_3_in_krishna_zone_4_first_time = 0 )
				DISPLAY_BRIEF_NOW ( 3802 )		// Get a V-Type now and follow orders!
			ELSE
				DISPLAY_BRIEF_NOW ( 3814 ) // Alright, head down to the Scientist area and kill some Scientist scum!
			ENDIF
		ENDIF

 	ENDIF


	IF ( z_m_3_in_krisgang_zone = 1 )


		IF  ( ( IS_CHARACTER_IN_MODEL ( shaft , buick ) )
		AND ( z_m_3_in_krishna_zone_4_first_time = 0 ) )
			DISPLAY_BRIEF_NOW ( 3803 ) // KILL THEM!
			z_m_3_kris = START_BONUS_CHECK ( krisgang , -1 , 50 , 0 , char , not_exclusive , by_vehicle , buick , krisgang , 9 ) 
			SET z_m_3_counter_total = 50
			SET z_m_3_in_krishna_zone_4_first_time = 1
			SET z_m_3_bonus_started = 1 
			ADD_ONSCREEN_COUNTER ( z_m_3_counter , z_m_3_counter_total )
			REMOVE_ARROW ( arrow )
		ENDIF


		IF  ( ( IS_CHARACTER_IN_MODEL ( shaft , buick ) )
		AND ( z_m_3_in_russian_gang_car_in_zone = 1 ) )
			SET z_m_3_in_russian_gang_car_in_zone = 0
			DISPLAY_BRIEF_NOW ( 3803 ) // Alright, head down to the Scientist area and kill some Scientist scum!
			REMOVE_ARROW ( arrow )
		ENDIF


		IF  ( ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , buick ) ) )
   		AND ( z_m_3_in_russian_gang_car_in_zone = 0 ) )
			SET z_m_3_in_russian_gang_car_in_zone = 1
			DISPLAY_BRIEF_NOW ( 3806 )		// Get a V-Type now and follow orders!
		ENDIF

	ENDIF
 

	// store counter
	
	IF ( z_m_3_bonus_started = 1 )
		STORE_BONUS_COUNT ( z_m_3_kris , z_m_3_total )   
	ENDIF

	// calculate count

	IF ( z_m_3_bonus_started = 1 )
		SET z_m_3_counter_total = ( z_m_3_constant_50 - z_m_3_total )
	ENDIF 

	
	// if bonus is passed						
	
	IF ( z_m_3_in_krishna_zone_4_first_time = 1 )								

		IF ( HAS_BONUS_PASSED ( z_m_3_kris ) )
			DISPLAY_BRIEF_NOW ( 3805 )  //"Well Done!" Now steal a stratosb and do it all again in the Zaibatsu Village.
			CLEAR_ONSCREEN_COUNTER ( z_m_3_counter )
			SET z_m_3_all_krishnas_dead = 1
			SET z_m_3_bonus_started = 0 
		ENDIF
	ENDIF


	// if bonus is failed

	IF ( z_m_3_in_krishna_zone_4_first_time = 1 )		
			
   		IF ( HAS_BONUS_FAILED ( z_m_3_kris ) )
   			CLEAR_ALL_BRIEFS ( )
   			DISPLAY_BRIEF_NOW ( 3812 )  //"You useless idiot!!"
   			CLEAR_ONSCREEN_COUNTER ( z_m_3_counter )
			SET flag_failed_zaib_med_phone1_2_m3 = 1
			DISPLAY_MESSAGE ( 3730 )
			RETURN
		ENDIF
	ENDIF


ENDWHILE


// part two - kill russians

WHILE_EXEC ( z_m_3_all_russians_dead = 0 )



	IF ( ( IS_CHAR_IN_GANGZONE ( shaft , russgang ) )
