			REMOVE_ARROW ( arrow )
			IF ( z_m_3_in_russian_zone_4_first_time = 0 )
				DISPLAY_BRIEF_NOW ( 3808 )		// Get a V-Type now and follow orders!
			ELSE
				DISPLAY_BRIEF_NOW ( 3816 ) // Alright, head down to the Scientist area and kill some Scientist scum!
			ENDIF
		ENDIF
 	ENDIF


	IF ( z_m_3_in_russgang_zone = 1 )


		IF  ( ( IS_CHARACTER_IN_MODEL ( shaft , krsnabus ) )
		AND ( z_m_3_in_russian_zone_4_first_time = 0 ) )
		   	DISPLAY_BRIEF_NOW ( 3809 ) // KILL THEM!
			z_m_3_russ = START_BONUS_CHECK ( rusgang , -1 , 50 , 0 , char , not_exclusive , by_vehicle , krsnabus , russgang , 10 ) 
			SET z_m_3_counter_2_total = 50
			SET z_m_3_in_russian_zone_4_first_time = 1
			SET z_m_3_bonus_started = 1 
			ADD_ONSCREEN_COUNTER ( z_m_3_counter_2 , z_m_3_counter_2_total )
			REMOVE_ARROW ( arrow )
		ENDIF


		IF  ( ( IS_CHARACTER_IN_MODEL ( shaft , krsnabus ) )
		AND ( z_m_3_in_krishna_gang_car_in_zone = 1 ) )
			SET z_m_3_in_krishna_gang_car_in_zone = 0
			DISPLAY_BRIEF_NOW ( 3809 ) // Alright, head down to the Scientist area and kill some Scientist scum!
			REMOVE_ARROW ( arrow )
		ENDIF


		IF  ( ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , krsnabus ) ) )
   		AND ( z_m_3_in_krishna_gang_car_in_zone = 0 ) )
			SET z_m_3_in_krishna_gang_car_in_zone = 1
			DISPLAY_BRIEF_NOW ( 3813 )		// Get a V-Type now and follow orders!
		ENDIF
	ENDIF
 

	// store counter
	
	IF ( z_m_3_bonus_started = 1 )
