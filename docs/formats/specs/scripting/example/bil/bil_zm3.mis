	// if bonus is passed						
	
	IF ( z_m_3_in_russian_zone_4_first_time = 1 )								

		IF ( HAS_BONUS_PASSED ( z_m_3_russ ) )
			CLEAR_ALL_BRIEFS ( )
			DISPLAY_BRIEF_NOW ( 3811 )  //"Well Done!"
			CLEAR_ONSCREEN_COUNTER ( z_m_3_counter_2 )
			SET z_m_3_all_russians_dead = 1 
		ENDIF
	ENDIF


	// if bonus is failed

	IF ( z_m_3_in_russian_zone_4_first_time = 1 )		
			
		IF ( HAS_BONUS_FAILED ( z_m_3_russ ) )
   			CLEAR_ALL_BRIEFS ( )
   			DISPLAY_BRIEF_NOW ( 3812 )  //"You useless idiot!!"
   			CLEAR_ONSCREEN_COUNTER ( z_m_3_counter_2 )
