// starts Zaibatsu med phone1 mission1
					

zaib_med_phone1_m1:

SET flag_failed_zaib_med_phone1_m1 = 0

//	DISABLE_THREAD_TRIGGER ( thr_zaib_med_phone1_m1 )
	DISPLAY_MESSAGE ( 3849 ) // you have PASSED the mission!"
	DISPLAY_BRIEF ( 3760 ) // "you have selected Zaibatsu med phone1 mission1"
	OPEN_DOOR ( z_m_1_door_1_1 )
	#ifdef PC
	OPEN_DOOR ( z_m_1_door_1_2 )
	#endif
	SET flag_on_mission	= 1
	SET flag_on_zaib_mission = 1
	z_m_1_group_1_leader = CREATE_CHAR ( 167.5 , 68.5 , 2.0 ) 10 90 criminal END
	ADD_CHAR_TO_GANG ( z_m_1_group_1_leader , russgang )
	#ifdef PC
	ADD_GROUP_TO_CHARACTER ( z_m_1_group_1_leader , 3 )
	#endif
	SET_CHAR_OBJECTIVE ( z_m_1_group_1_leader , wait_on_foot ) 
	SET_CHAR_THREAT_REACTION ( z_m_1_group_1_leader , no_reaction )
	GIVE_WEAPON ( z_m_1_group_1_leader , machine_gun )
	POINT_ARROW_AT ( arrow , z_m_1_group_1_leader )

	#ifdef PSX
	SET_RECYCLE_MODEL_WANTED ( buick ) 
	#endif

WHILE_EXEC ( z_m_1_picked_up_group_1_leader = 0 )

 
	IF ( ( ( LOCATE_ANOTHER_CHARACTER_BY_CAR ( shaft , z_m_1_group_1_leader , 3.0 , 3.0 ) ) 
	AND ( IS_CHARACTER_IN_MODEL ( shaft , buick ) ) )
	AND ( z_m_1_in_buick_at_group_1_leader = 0 ) )
		SET z_m_1_in_buick_at_group_1_leader = 1
		STORE_CAR_CHARACTER_IS_IN ( shaft , z_m_1_group_1_car )
		SET_CHAR_OBJECTIVE ( z_m_1_group_1_leader , enter_car_as_passenger , z_m_1_group_1_car )
		SET z_m_1_group_1_leader_in_car = 1
		
		ELSE
		
		IF ( ( ( ( IS_CHARACTER_IN_ANY_CAR ( shaft ) ) 
		AND ( LOCATE_ANOTHER_CHARACTER_BY_CAR ( shaft , z_m_1_group_1_leader , 3.0 , 3.0 ) ) )
		AND ( z_m_1_in_wrong_car_at_group_1_leader = 0 ) )
		AND ( z_m_1_in_buick_at_group_1_leader = 0 ) )
			DISPLAY_BRIEF_NOW ( 3764 ) // "I'm not going deal till you get the right vehicle! You need a hot dog van!"
			SET z_m_1_in_wrong_car_at_group_1_leader = 1
		ENDIF
	ENDIF


	IF ( ( ( z_m_1_group_1_leader_in_car = 1 )
	AND ( z_m_1_group_1_leader_obj1_pass = 0 ) )
	AND ( IS_CHAR_OBJECTIVE_PASSED ( z_m_1_group_1_leader ) ) )
		REMOVE_ARROW ( arrow )
		IF ( NOT ( DELAY ( 60 ) ) ) 
			SET_CHAR_OBJECTIVE ( z_m_1_group_1_leader , leave_car , z_m_1_group_1_car )
			SET z_m_1_group_1_leader_obj1_pass = 1
		ENDIF
	ENDIF
		

	IF ( ( z_m_1_group_1_leader_obj1_pass = 1 )
	AND ( IS_CHAR_OBJECTIVE_PASSED ( z_m_1_group_1_leader ) ) )
//		SET_CHAR_OBJECTIVE ( z_m_1_group_1_leader , no_obj ) 
		MAKE_CHAR_DO_NOTHING ( z_m_1_group_1_leader )
		SET_CHAR_THREAT_REACTION ( z_m_1_group_1_leader , react_as_normal )
		SET z_m_1_group_1_leader_obj1_pass = 2
		SET z_m_1_picked_up_group_1_leader = 1
	ENDIF

	
	IF ( ( ( NOT ( IS_CHARACTER_IN_ANY_CAR ( shaft ) ) )
	AND ( LOCATE_ANOTHER_CHARACTER_ON_FOOT ( shaft , z_m_1_group_1_leader , 2.0 , 2.0 ) ) )
	AND ( z_m_1_on_foot_at_group_1_leader = 0 ) )
		DISPLAY_BRIEF_NOW ( 3767 ) // "go get a car and we'll do business"
		SET z_m_1_on_foot_at_group_1_leader = 1
	ENDIF

   	
	IF ( ( z_m_1_in_wrong_car_at_group_1_leader = 1 )
	AND ( NOT ( IS_ITEM_ACCURATELY_ONSCREEN ( z_m_1_group_1_leader ) ) ) )
		SET z_m_1_in_wrong_car_at_group_1_leader = 0
	ENDIF


	IF ( (  z_m_1_on_foot_at_group_1_leader = 1 )
	AND ( NOT ( IS_ITEM_ACCURATELY_ONSCREEN ( z_m_1_group_1_leader ) ) ) )
		SET z_m_1_on_foot_at_group_1_leader = 0
	ENDIF

	
	IF ( ( HAS_CHARACTER_DIED ( z_m_1_group_1_leader ) )
	AND ( flag_failed_zaib_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3761 ) // "You were supposed to do business with him not kill him, you have failed me!"
		SET flag_failed_zaib_med_phone1_m1	= 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF	
	
	
ENDWHILE


DISPLAY_BRIEF_NOW ( 3768 ) // "nice doing business with you!"
DELAY_HERE ( 90 )
DISPLAY_BRIEF ( 3769 ) // "ok get moving to the next guy"

#ifdef PC
z_m_1_group_2_leader = CREATE_CHAR ( 91.5 , 159.5 , 3.0 ) 8 90 criminal END
