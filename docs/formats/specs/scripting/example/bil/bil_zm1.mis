WHILE_EXEC ( NOT ( LOCATE_ANOTHER_CHARACTER_ON_FOOT ( shaft , z_m_1_group_2_leader , 1.0 , 1.0  ) ) )

	
	IF ( ( HAS_CHARACTER_DIED ( z_m_1_group_2_leader ) )
	AND ( flag_failed_zaib_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3761 ) // "You were supposed to do business with him not kill him, you have failed me!"
		SET flag_failed_zaib_med_phone1_m1	= 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF	
	
	
ENDWHILE



	// player has located the second dealer

	DISPLAY_BRIEF ( 3763 ) // "Who are you, new guy huh. It's all there you don't need to count it."			
//	SET_CHAR_OBJECTIVE ( z_m_1_group_2_leader , no_obj )
	MAKE_CHAR_DO_NOTHING ( z_m_1_group_2_leader )
	SET_CHAR_THREAT_REACTION ( z_m_1_group_2_leader , react_as_normal )
	REMOVE_ARROW ( arrow )

	DELAY_HERE ( 120 )
	DISPLAY_BRIEF_NOW ( 3772 ) // "Get moving, the next guy's a Russian make sure he pays you."		
	z_m_1_group_3_leader = CREATE_CHAR ( 188.2 , 100.8 , 3.0 ) 10 90 criminal END
	ADD_CHAR_TO_GANG ( z_m_1_group_3_leader , russgang )
	ADD_GROUP_TO_CHARACTER ( z_m_1_group_3_leader , 4 )
	SET_CHAR_OBJECTIVE ( z_m_1_group_3_leader , wait_on_foot ) 
	SET_CHAR_THREAT_REACTION ( z_m_1_group_3_leader , no_reaction )
    GIVE_WEAPON ( z_m_1_group_3_leader , machine_gun )
    POINT_ARROW_AT ( arrow , z_m_1_group_3_leader )
		
	z_m_1_powerup_1 = CREATE_OBJ ( 188.0 , 105.0 , 2.0 ) 0 COLLECT_06 15 END
	FORCE_CLEANUP ( z_m_1_powerup_1 )

WHILE_EXEC ( NOT ( LOCATE_ANOTHER_CHARACTER_ON_FOOT ( shaft , z_m_1_group_3_leader , 1.0 , 1.0  ) ) )

	
	IF ( ( HAS_CHARACTER_DIED ( z_m_1_group_3_leader ) )
	AND ( flag_failed_zaib_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3761 ) // "You were supposed to do business with him not kill him, you have failed me!"
		SET flag_failed_zaib_med_phone1_m1	= 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF	
	
	
ENDWHILE


	// player has located the third dealer

	DISPLAY_BRIEF ( 3766 ) // "Fuck you I ain't got your money."			
	REMOVE_ARROW ( arrow )
	SET_CHAR_OBJECTIVE ( z_m_1_group_3_leader , no_obj )
	DELAY_HERE ( 120 )
	DISPLAY_BRIEF ( 3770 ) // "Nobody refuses to pay me, kill him and his men"
	POINT_ARROW_AT ( arrow , z_m_1_group_3_leader )
	SET_CHAR_OBJECTIVE ( z_m_1_group_3_leader , flee_char_on_foot_always , shaft )
	SET_CHAR_THREAT_REACTION ( z_m_1_group_3_leader , no_reaction )
	
WHILE_EXEC ( NOT ( HAS_CHARACTER_DIED ( z_m_1_group_3_leader ) ) )
	

	DO_NOWT	


ENDWHILE

			
	REMOVE_ARROW ( arrow )

	DELAY_HERE ( 120 )
	DISPLAY_BRIEF ( 3773 ) // "This is the last guy, he's a little paranoid, thinks the cops are watching him."	
	z_m_1_group_4_leader = CREATE_CHAR ( 63.5 , 128.5 , 4.0 ) 8 90 criminal END
	ADD_CHAR_TO_GANG ( z_m_1_group_4_leader , zaibgang )
	#ifdef PC
	ADD_GROUP_TO_CHARACTER ( z_m_1_group_4_leader , 2 )
	#endif
	#ifdef PSX
