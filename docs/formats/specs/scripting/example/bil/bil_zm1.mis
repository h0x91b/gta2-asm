		OPEN_DOOR ( z_m_1_door_1_2 )
		#endif
		POINT_ARROW_AT ( arrow , z_m_1_truck_1 )
	ENDIF
	

	IF ( ( HAS_CHARACTER_DIED ( z_m_1_tower_guard_1 ) )
	AND ( z_m_1_tower_guard_1_dead = 0 ) )
		SET z_m_1_tower_guard_1_dead = 1
	ENDIF


	IF ( ( HAS_CHARACTER_DIED ( z_m_1_tower_guard_2 ) )
	AND ( z_m_1_tower_guard_2_dead = 0 ) )
		SET z_m_1_tower_guard_2_dead = 1
	ENDIF


	IF ( ( HAS_CHARACTER_DIED ( z_m_1_tower_guard_3 ) )
	AND ( z_m_1_tower_guard_3_dead = 0 ) )
		SET z_m_1_tower_guard_3_dead = 1
	ENDIF


	IF ( ( HAS_CHARACTER_DIED ( z_m_1_tower_guard_4 ) )
	AND ( z_m_1_tower_guard_4_dead = 0 ) )
		SET z_m_1_tower_guard_4_dead = 1
	ENDIF
		

	// if player is seen by guard1
	
	IF ( ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_1_tower_guard_1 ) ) 
   	AND ( z_m_1_tower_guard_1_spotted_player = 0 ) )
	AND ( z_m_1_tower_guard_1_dead = 0 ) )
		SET z_m_1_tower_guard_1_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3786 ) // "Thirsty? All I've got are these Molotov Cocktails! Enjoy!"	 
	ENDIF

	
	// if player is seen by guard1
	
	IF ( ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_1_tower_guard_2 ) ) 
   	AND ( z_m_1_tower_guard_2_spotted_player = 0 ) )
	AND ( z_m_1_tower_guard_2_dead = 0 ) )
		SET z_m_1_tower_guard_2_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3787 ) // "You'll never get out of here alive!"	 
	ENDIF


	// if player is seen by guard1
	
	IF ( ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_1_tower_guard_3 ) ) 
   	AND ( z_m_1_tower_guard_3_spotted_player = 0 ) )
	AND ( z_m_1_tower_guard_3_dead = 0 ) )
		SET z_m_1_tower_guard_3_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3788 ) // "Who the fuck are you! Get off of this roof!"	 
	ENDIF


	// if player is seen by guard1
	
	IF ( ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_1_tower_guard_4 ) ) 
   	AND ( z_m_1_tower_guard_4_spotted_player = 0 ) )
	AND ( z_m_1_tower_guard_4_dead = 0 ) )
		SET z_m_1_tower_guard_4_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3789 ) // "You just came to the wrong place stranger!"	 
	ENDIF


// if player gets in car points at target

   	IF ( ( ( IS_CHARACTER_IN_CAR ( shaft , z_m_1_truck_1 ) )
   	AND ( z_m_1_in_truck_1 = 0 ) )
	AND ( z_m_1_door_1_open = 1 ) )
		SET z_m_1_in_truck_1 = 1
		DISPLAY_BRIEF_NOW ( 3779 ) // "get the truck across to the factory!"
   		POINT_ARROW_AT ( arrow , 61.0 , 166.0 , 2.0 )
   	ENDIF


// if player gets out of car points back at car and says to get back in
		
   	IF ( ( ( NOT ( IS_CHARACTER_IN_CAR ( shaft , z_m_1_truck_1 ) ) )
	AND ( z_m_1_in_truck_1 = 1 ) )
	AND ( z_m_1_door_1_open = 1 ) )
		SET z_m_1_in_truck_1 = 0
		DISPLAY_BRIEF_NOW ( 3780 ) // "Where the fuck are you going? Get back in the truck before you really piss me off!"
		POINT_ARROW_AT ( arrow , z_m_1_truck_1 )
	ENDIF

	
	// if player gets in car points at target

   	IF ( ( ( IS_CHARACTER_IN_CAR ( shaft , z_m_1_truck_1 ) )
   	AND ( z_m_1_in_truck_1_door_1 = 0 ) )
	AND ( z_m_1_door_1_open = 0 ) )
		SET z_m_1_in_truck_1_door_1 = 1
		DISPLAY_BRIEF_NOW ( 3790 ) // "The doors are still closed asshole! get out of the truck and take out the generator!"
   	ENDIF


// if player gets out of car points back at car and says to get back in
		
   	IF ( ( ( NOT ( IS_CHARACTER_IN_CAR ( shaft , z_m_1_truck_1 ) ) )
	AND ( z_m_1_in_truck_1_door_1 = 1 ) )
	AND ( z_m_1_door_1_open = 0 ) )
		SET z_m_1_in_truck_1_door_1 = 0
	ENDIF


// waits for player outside door, then parks the truck
	
//	IF ( ( ( LOCATE_CHARACTER_BY_CAR ( shaft , 61.0 , 166.0 , 2.0 , 2.0 , 2.0 ) ) 
//	AND ( IS_CHARACTER_IN_CAR ( shaft , z_m_1_truck_1 ) ) )
	IF ( ( IS_CAR_IN_BLOCK ( z_m_1_truck_1 , 61.0 , 166.0 , 2.0 , 2.0 , 2.0 ) )
	AND ( z_m_1_in_truck_1_parking = 0 ) )
		PARK ( z_m_1_truck_1 , z_m_1_door_2 )
		SET z_m_1_in_truck_1_parking = 1
	ENDIF	


// waits for truck to finish parking, then passes mission


	IF ( ( z_m_1_in_truck_1_parking = 1	)
	AND ( HAS_PARK_FINISHED ( ) ) )
		SET flag_passed_zaib_med_phone1_m1	= 1
		SET z_m_1_truck_1_parked = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3783 ) // "Well done you have passed the mission!"
		++ counter_all_missions_passed
		DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
		ADD_SCORE ( shaft , 60000 )
		ADD_MULTIPLIER ( shaft , 1 )
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( zaibgang , shaft , 1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
		IF ( flag_passed_zaib_med_phone1_2_m3 = 1 )
			SET_PHONE_DEAD ( ph_zaib_med_phone1 ) 
			DISABLE_THREAD_TRIGGER ( thr_zaib_med_phone1_m1 )
		ENDIF
		RETURN
	ENDIF


ENDWHILE

	 

//------------------------------------------------------------------------------------------
//------------------------------------------------------------------------------------------



// deletes all objects when Zaibatsu med phone1 mission1 is finished...
				
clean_up_zaib_med_phone1_m1: 
	
	REMOVE_ARROW ( arrow )
	REMOVE_ARROW ( arrow_2 )
	REMOVE_ARROW ( arrow_3 )
	REMOVE_ARROW ( arrow_4 )
	OPEN_DOOR ( z_m_1_door_1_1 )
	#ifdef PC
	OPEN_DOOR ( z_m_1_door_1_2 )
	#endif
	MAKE_DOOR_MANUAL ( z_m_1_door_2 ) 
	
	IF ( z_m_1_suitcase_1_created = 1 )
		DELETE_ITEM ( z_m_1_suitcase_1 )
	ENDIF

	IF ( flag_passed_zaib_med_phone1_m1 = 1 )
		++ flag_zaib_missions_passed
		++ flag_all_missions_passed
		IF ( flag_zaib_missions_passed = 7 )
			DISPLAY_BRIEF ( 3675 ) // "Good work that should stop them building into our community"
			DISPLAY_MESSAGE ( 3674 ) // you have PASSED the mission!"
		ENDIF
	ENDIF

	IF ( flag_failed_zaib_med_phone1_m1 = 1 )
		++ flag_zaib_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( zaibgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
	ENDIF

	IF ( CHECK_DEATHARREST_EXECUTED ( ) )
		++ flag_zaib_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( zaibgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
	ENDIF

	MISSION_HAS_FINISHED ( )
	
	SET flag_on_mission	= 0
	SET flag_on_zaib_mission = 0
	
	RETURN


MISSIONSTART

	GOSUB zaib_med_phone1_m1:

	GOSUB clean_up_zaib_med_phone1_m1:

MISSIONEND



