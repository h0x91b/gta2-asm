	POINT_ARROW_AT ( arrow , z_m_1_group_4_leader )

	z_m_1_group_4_leader_myman = CREATE_CHAR ( 63.2 , 128.2 , 4.0 ) 8 90 drone END
	ADD_CHAR_TO_GANG ( z_m_1_group_4_leader_myman , zaibgang )
	SET_CHAR_OBJECTIVE  ( z_m_1_group_4_leader_myman , wait_on_foot ) 
	SET_CHAR_THREAT_REACTION ( z_m_1_group_4_leader_myman , no_reaction )
	GIVE_WEAPON ( z_m_1_group_4_leader_myman , machine_gun )
	

WHILE_EXEC ( NOT ( LOCATE_ANOTHER_CHARACTER_ON_FOOT ( shaft , z_m_1_group_4_leader , 1.0 , 1.0  ) ) )

	
	IF ( ( HAS_CHARACTER_DIED ( z_m_1_group_4_leader ) )
	AND ( flag_failed_zaib_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3761 ) // "You were supposed to do business with him not kill him, you have failed me!"
		SET flag_failed_zaib_med_phone1_m1	= 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF
	
	
	IF ( ( HAS_CHARACTER_DIED ( z_m_1_group_4_leader_myman ) )
	AND ( flag_failed_zaib_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3761 ) // "You were supposed to do business with him not kill him, you have failed me!"
		SET flag_failed_zaib_med_phone1_m1	= 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF	
	
	
ENDWHILE


	// player has located the fourth dealer

DISPLAY_BRIEF ( 3765 ) // "follow my man he'll drop it round the corner."				
SET_CHAR_OBJECTIVE  ( z_m_1_group_4_leader_myman , goto_area_on_foot , 74.5 , 133.5 , 2.0 ) 
SET_CHAR_THREAT_REACTION ( z_m_1_group_4_leader_myman , no_reaction )
POINT_ARROW_AT ( arrow , z_m_1_group_4_leader_myman )
  

WHILE_EXEC ( z_m_1_located_briefcase_1 = 0 )

	IF ( ( HAS_CHARACTER_DIED ( z_m_1_group_4_leader_myman ) )
	AND ( flag_failed_zaib_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3774 ) // "You were supposed to pick up the briefcase not kill him, you have failed me!"
		SET flag_failed_zaib_med_phone1_m1	= 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF	
	
  IF ( ( IS_CHAR_OBJECTIVE_PASSED ( z_m_1_group_4_leader_myman ) ) 
	AND ( z_m_1_group_4_leader_myman_obj1_passed = 0 ) )
		SET z_m_1_group_4_leader_myman_obj1_passed = 1	
		SET_CHAR_OBJECTIVE  ( z_m_1_group_4_leader_myman , goto_area_on_foot , 63.2 , 128.2 , 4.0 )
		z_m_1_suitcase_1 = CREATE_OBJ ( 74.5 , 133.5 , 2.0 ) 0 briefcase END
		SET z_m_1_suitcase_1_created = 1
		POINT_ARROW_AT ( arrow , z_m_1_suitcase_1 )	
	ENDIF

	IF ( ( z_m_1_group_4_leader_myman_obj1_passed = 1 )
	AND ( LOCATE_CHARACTER_ON_FOOT ( shaft , 74.5 , 133.5 , 2.0 , 0.5 , 0.5  ) ) )
		SET z_m_1_group_4_leader_myman_obj1_passed = 2
		SET z_m_1_located_briefcase_1 = 1
		REMOVE_ARROW ( arrow )
		DELETE_ITEM ( z_m_1_suitcase_1 )	
		SET z_m_1_suitcase_1_created = 0
		DISPLAY_BRIEF ( 3775 ) // "Good job you got all of my money."	
		SET_CHAR_THREAT_REACTION ( z_m_1_group_4_leader , react_as_normal )
	ENDIF

ENDWHILE


DELAY_HERE ( 120 )
CLOSE_DOOR ( z_m_1_door_1_1 )
#ifdef PC
