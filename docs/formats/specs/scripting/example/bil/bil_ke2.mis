AND ( flag_passed_kris_easy_phone2_m1 = 0 )	)
	CLEAR_ALL_BRIEFS ( )
	DISPLAY_BRIEF ( 3488 ) // "Good work this will give my people courage, and it should make the cops think twice before getting into my business"
	++ counter_all_missions_passed
	SET flag_passed_kris_easy_phone2_m1 = 1
	DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
	ADD_SCORE ( shaft , 40000 )
	ADD_MULTIPLIER ( shaft , 1 )
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , 1 ) 
	CLEAR_WANTED_LEVEL ( shaft )
	SET_PHONE_DEAD ( ph_kris_easy_phone2 ) 
	DISABLE_THREAD_TRIGGER ( thr_kris_easy_phone2_m1 ) 
	RETURN
ENDIF					
							

	

//------------------------------------------------------------------------------------------
//------------------------------------------------------------------------------------------

clean_up_kris_easy_phone2_m1:
	
REMOVE_ARROW ( arrow )
REMOVE_ARROW ( arrow_2 )
REMOVE_ARROW ( arrow_3 )
REMOVE_ARROW ( arrow_4 )
		
		
IF ( flag_passed_kris_easy_phone2_m1 = 1 )
	++ flag_kris_missions_passed
	++ flag_all_missions_passed
	IF ( flag_kris_missions_passed = 7 )
		DISPLAY_BRIEF ( 3671 ) // "Good work that should stop them building into our community"
		DISPLAY_MESSAGE ( 3670 ) // you have PASSED the mission!"
	ENDIF
ENDIF

IF ( flag_failed_kris_easy_phone2_m1 = 1 )
	++ flag_kris_missions_failed
	++ flag_all_missions_failed
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
	CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
ENDIF

IF ( CHECK_DEATHARREST_EXECUTED ( ) )
	++ flag_kris_missions_failed
	++ flag_all_missions_failed
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
	CLEAR_WANTED_LEVEL ( shaft )
ENDIF

MISSION_HAS_FINISHED ( )

SET flag_on_mission = 0
SET flag_on_kris_mission = 0

RETURN
	
	
MISSIONSTART

	GOSUB kris_easy_phone2_m1:

	GOSUB clean_up_kris_easy_phone2_m1:

MISSIONEND	





