WHILE_EXEC ( z_h_1_mib_car_delivered = 0 )

	
	
	IF ( ( IS_CHARACTER_IN_MODEL ( shaft , edselfbi ) )   
	AND ( z_h_1_player_in_mib_car = 0 ) )
		DISPLAY_BRIEF_NOW ( 4004 )  //"Good now bring the car to the garage!"
	  	POINT_ARROW_AT ( arrow , 13.0 , 200.0 , 2.0 )
		SET z_h_1_player_in_mib_car = 1
		STORE_CAR_CHARACTER_IS_IN ( shaft , z_h_1_stolen_MIB )
		UPDATE_DOOR_TARGET ( z_h_1_door_1 , z_h_1_stolen_MIB )
	ENDIF
	
	
	IF ( ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , edselfbi ) ) )  
	AND ( z_h_1_player_in_mib_car = 1 ) )
		DISPLAY_BRIEF_NOW ( 4005 ) //"Get a mib car!"
		REMOVE_ARROW ( arrow )
		SET z_h_1_player_in_mib_car = 0
	ENDIF	
	
	
	
	// waits for player outside door, then parks the vehicle
	
//	IF ( ( ( LOCATE_CHARACTER_BY_CAR ( shaft , 13.0 , 199.0 , 2.0 , 2.0 , 2.0 ) ) 
//	AND ( IS_CHARACTER_IN_CAR ( shaft , z_h_1_stolen_MIB ) ) )
	IF ( ( IS_CAR_IN_BLOCK ( z_h_1_stolen_MIB , 13.0 , 199.0 , 2.0 , 2.0 , 2.0 ) )
	AND ( z_h_1_park_mib_car_started = 0 ) )
		REMOVE_ARROW ( arrow )
		PARK ( z_h_1_stolen_MIB , z_h_1_door_1 )
		SET z_h_1_park_mib_car_started = 1
	ENDIF
		
	
	IF ( ( z_h_1_park_mib_car_started = 1 )
	AND ( HAS_PARK_FINISHED () ) )
		SET z_h_1_mib_car_delivered = 1
		SET z_h_1_park_mib_car_started = 2
		z_h_1_MIB_recreated = CREATE_CAR ( 13.5 , 195.0 , 2.0 ) 1 177 edselfbi END
	ENDIF


ENDWHILE
	
	 
