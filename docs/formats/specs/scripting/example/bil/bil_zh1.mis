//player has delivered the swat van and is now told to steal a MIB car

z_h_1_powerup_1 = CREATE_OBJ ( 9.5 , 205.5 , 2.0 ) 0 COLLECT_09 END
FORCE_CLEANUP ( z_h_1_powerup_1 )
z_h_1_powerup_2 = CREATE_OBJ ( 10.5 , 205.5 , 2.0 ) 0 COLLECT_30 END
