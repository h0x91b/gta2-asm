//player has delivered all three vehicles and so is rewarded

IF ( ( ( ( z_h_1_swat_van_delivered = 1 )
AND ( z_h_1_mib_car_delivered = 1 ) )
AND ( z_h_1_tank_delivered = 1 ) )
AND ( flag_passed_zaib_hard_phone_m1 = 0 ) )
	SET flag_passed_zaib_hard_phone_m1	= 1
	CLEAR_ALL_BRIEFS ( )
	DISPLAY_BRIEF ( 4009 ) // "Well done you have passed the mission!"
	++ counter_all_missions_passed
	DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
	ADD_SCORE ( shaft , 80000 )
	ADD_MULTIPLIER ( shaft , 1 ) 
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( zaibgang , shaft , 1 )
	CLEAR_WANTED_LEVEL ( shaft )
	RETURN
ENDIF
	
	 
RETURN
		  



