// starts Zaibatsu hard phone1 mission1
					

zaib_hard_phone_m1:

SET flag_failed_zaib_hard_phone_m1 = 0


//	DISABLE_THREAD_TRIGGER ( thr_zaib_hard_phone1_m1 )
	DISPLAY_MESSAGE ( 3852 ) // you have PASSED the mission!"
	SET flag_on_mission	= 1
	SET flag_on_zaib_mission = 1
   	
// 	z_h_1_SWAT = CREATE_CAR ( 10.5 , 202.5 , 2.0 ) 1 3 swatvan END
//	z_h_1_MIB = CREATE_CAR ( 12.5 , 202.5 , 2.0 ) 1 3 edselfbi END
//	z_h_1_TANK = CREATE_CAR ( 14.5 , 202.5 , 2.0 ) 1 3 tank END


DISPLAY_BRIEF ( 4000 )  //"We want you to steal a swat van!"


// awaits player is told to steal a swat van
			
	
WHILE_EXEC ( z_h_1_swat_van_delivered = 0 )

							
	IF ( ( IS_CHARACTER_IN_MODEL ( shaft , swatvan ) )   
	AND ( z_h_1_player_in_swat_van = 0 ) )
		DISPLAY_BRIEF_NOW ( 4001 )  //"Good now bring the van to the garage!"
		POINT_ARROW_AT ( arrow , 13.0 , 200.0 , 2.0 )
		SET z_h_1_player_in_swat_van = 1
		STORE_CAR_CHARACTER_IS_IN ( shaft , z_h_1_stolen_SWAT )
		UPDATE_DOOR_TARGET ( z_h_1_door_1 , z_h_1_stolen_SWAT )
		MAKE_DOOR_AUTOMATIC ( z_h_1_door_1 )
	ENDIF
	
	
	IF ( ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , swatvan ) ) )  
	AND ( z_h_1_player_in_swat_van = 1 ) )
		DISPLAY_BRIEF_NOW ( 4002 ) //"Get a swat van!"
		REMOVE_ARROW ( arrow )
		SET z_h_1_player_in_swat_van = 0
	ENDIF	
	

	// waits for player outside door, then parks the vehicle
	
//	IF ( ( ( LOCATE_CHARACTER_BY_CAR ( shaft , 13.0 , 199.0 , 2.0 , 2.0 , 2.0 ) ) 
//	AND ( IS_CHARACTER_IN_CAR ( shaft , z_h_1_stolen_SWAT ) ) )
	IF ( ( IS_CAR_IN_BLOCK ( z_h_1_stolen_SWAT , 13.0 , 199.0 , 2.0 , 2.0 , 2.0 ) )
	AND ( z_h_1_park_swat_van_started = 0 ) )
		REMOVE_ARROW ( arrow )
		PARK ( z_h_1_stolen_SWAT , z_h_1_door_1 )
		SET z_h_1_park_swat_van_started = 1
	ENDIF
		
	
	IF ( ( z_h_1_park_swat_van_started = 1 )
	AND ( HAS_PARK_FINISHED () ) )
		SET z_h_1_swat_van_delivered = 1
		SET z_h_1_park_swat_van_started = 2
		z_h_1_SWAT_recreated = CREATE_CAR ( 11.5 , 195.0 , 2.0 ) 1 183 swatvan END
	ENDIF
		


ENDWHILE	
	  	 
