//player has safely delivered the mib car to the garage and is now told to get a tank
	
	
z_h_1_powerup_4 = CREATE_OBJ ( 15.5 , 205.5 , 2.0 ) 0 COLLECT_03 END
FORCE_CLEANUP ( z_h_1_powerup_4 )
z_h_1_powerup_5 = CREATE_OBJ ( 16.5 , 205.5 , 2.0 ) 0 COLLECT_30 END
FORCE_CLEANUP ( z_h_1_powerup_5 )
