// objects for Zaibatsu hard phone mission1		
	

COUNTER z_h_1_swat_van_delivered = 0

COUNTER z_h_1_player_in_swat_van = 0

COUNTER z_h_1_mib_car_delivered = 0

COUNTER z_h_1_player_in_mib_car = 0

COUNTER z_h_1_tank_delivered = 0

COUNTER z_h_1_player_in_tank = 0 

COUNTER z_h_1_park_swat_van_started = 0 

COUNTER z_h_1_park_mib_car_started = 0

COUNTER z_h_1_park_tank_started = 0 

