FORCE_CLEANUP ( z_h_1_powerup_6 )
	
DISPLAY_BRIEF ( 4006 )  //"We now want a tank, so go get us one!"

	
WHILE_EXEC ( z_h_1_tank_delivered = 0 )

	
	
	IF ( ( IS_CHARACTER_IN_MODEL ( shaft , tank ) )   
	AND ( z_h_1_player_in_tank = 0 ) )
		DISPLAY_BRIEF_NOW ( 4007 )  //"Good now bring the tank to the garage!"
	  	POINT_ARROW_AT ( arrow , 13.0 , 200.0 , 2.0 )
		SET z_h_1_player_in_tank = 1
		STORE_CAR_CHARACTER_IS_IN ( shaft , z_h_1_stolen_tank )
		UPDATE_DOOR_TARGET ( z_h_1_door_1 , z_h_1_stolen_tank )
	ENDIF
	
	
	IF ( ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , tank ) ) )  
	AND ( z_h_1_player_in_tank = 1 ) )
		DISPLAY_BRIEF_NOW ( 4008 ) //"Get a tank!"
		REMOVE_ARROW ( arrow )
		SET z_h_1_player_in_tank = 0
	ENDIF	
	
   	
	// waits for player outside door, then parks the vehicle
	
//	IF ( ( ( LOCATE_CHARACTER_BY_CAR ( shaft , 13.0 , 199.0 , 2.0 , 2.0 , 2.0 ) ) 
