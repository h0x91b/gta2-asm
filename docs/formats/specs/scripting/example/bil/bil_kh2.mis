RETURN



// deletes all objects when Krishna hard phone mission1 is finished...
				
clean_up_kris_hard_phone_m2: 
	
	REMOVE_ARROW ( arrow )
	REMOVE_ARROW ( arrow_2 )
	REMOVE_ARROW ( arrow_3 )
	REMOVE_ARROW ( arrow_4 )
	SET_DEATHARREST_STATE ( shaft , ON )

	IF ( k_h_2_kris_group_1_created = 1 )
		IF ( NOT ( HAS_CHARACTER_DIED ( k_h_2_kris_group_1 ) ) )
			DESTROY_GROUP ( shaft )
			MAKE_CHAR_DO_NOTHING ( k_h_2_kris_group_1 )
		ENDIF
	ENDIF
			
	IF ( k_h_2_suitcase_1_created = 1 )
		DELETE_ITEM ( k_h_2_suitcase_1 )
	ENDIF

	IF ( k_h_2_suitcase_2_created = 1 )
		DELETE_ITEM ( k_h_2_suitcase_2 )
	ENDIF

	IF ( k_h_2_suitcase_3_created = 1 )
		DELETE_ITEM ( k_h_2_suitcase_3 )
	ENDIF

	IF ( k_h_2_suitcase_4_created = 1 )
		DELETE_ITEM ( k_h_2_suitcase_4 )
	ENDIF
		
	IF ( flag_passed_kris_hard_phone_m2 = 1 )
		++ flag_kris_missions_passed
		++ flag_all_missions_passed
		IF ( flag_kris_missions_passed = 7 )
			DISPLAY_BRIEF ( 3671 ) // "Good work that should stop them building into our community"
			DISPLAY_MESSAGE ( 3670 ) // you have PASSED the mission!"
		ENDIF
	ENDIF

	IF ( flag_failed_kris_hard_phone_m2 = 1 )
		++ flag_kris_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
	ENDIF

	IF ( CHECK_DEATHARREST_EXECUTED ( ) )
		++ flag_kris_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
	ENDIF

	MISSION_HAS_FINISHED ( )
	
	SET flag_on_mission	= 0
	SET flag_on_kris_mission = 0
	
	RETURN



MISSIONSTART

	GOSUB kris_hard_phone_m2:

	GOSUB clean_up_kris_hard_phone_m2:

MISSIONEND



