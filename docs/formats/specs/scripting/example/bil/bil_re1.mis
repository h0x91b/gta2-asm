	AND ( r_e_1_in_hotdog_van_1_parking = 0 ) )
//	AND ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_hotdog_van_1 ) ) )
		PARK ( r_e_1_hotdog_van_1 , r_e_1_door_2 )
		SET r_e_1_in_hotdog_van_1_parking = 1
	ENDIF	


	IF ( ( r_e_1_in_hotdog_van_1_parking = 1 )
	AND ( HAS_PARK_FINISHED ( ) ) )
		SET r_e_1_hotdog_van_1_parked = 1
	ENDIF
		 

	IF ( ( IS_CAR_WRECKED ( r_e_1_hotdog_van_1 ) )
	AND ( flag_failed_russ_easy_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
