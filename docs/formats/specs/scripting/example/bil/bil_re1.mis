	AND ( r_e_1_bus_full_yet < 2 ) )
		IF ( ( NOT ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_bus_1 ) ) )
		AND ( r_e_1_in_a_bus_2 = 0 ) )
			DISPLAY_BRIEF_NOW ( 3402 ) // "What are you doing, you take forever to steal a bus and then you leave it behind. Get your arse in a bus!"
			SET r_e_1_in_a_bus_2 = 1
			POINT_ARROW_AT ( arrow , r_e_1_bus_1 )
		ENDIF
	ENDIF


	IF ( ( r_e_1_in_a_bus = 1 )
	AND ( r_e_1_bus_full_yet = 2 ) )
		IF ( ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_bus_1 ) )
		AND ( r_e_1_in_a_full_bus_2 = 1 ) )
			DISPLAY_BRIEF_NOW ( 3421 ) // "Stop pissing about and get the bus to a bus stop and fill it with people!"
			SET r_e_1_in_a_full_bus_2 = 0
			POINT_ARROW_AT ( arrow , 184.0 , 31.0 , 2.0 )
		ENDIF
	ENDIF


	IF ( ( r_e_1_in_a_bus = 1 )
	AND ( r_e_1_bus_full_yet = 2 ) )
		IF ( ( NOT ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_bus_1 ) ) )
		AND ( r_e_1_in_a_full_bus_2 = 0 ) )
			DISPLAY_BRIEF_NOW ( 3422 ) // "What are you doing, it took you long enough to fill that bus then you leave it behind. Get your arse in the bus!"
			SET r_e_1_in_a_full_bus_2 = 1
			POINT_ARROW_AT ( arrow , r_e_1_bus_1 )
		ENDIF
	ENDIF


	IF ( r_e_1_in_a_bus = 1 )
		IF ( IS_CAR_WRECKED ( r_e_1_bus_1 ) )
			DISPLAY_BRIEF_NOW ( 3423 ) // "You arsehole! Now you have to do it all over again! Now go and steal a bus!"
			SET r_e_1_bus_full = 0
			SET r_e_1_bus_full_yet = 0
			SET r_e_1_in_a_bus = 0
			SET r_e_1_in_a_bus_2 = 0
			SET r_e_1_in_a_full_bus_2 = 0
			REMOVE_ARROW ( arrow )
		ENDIF
	ENDIF


	IF ( ( ( ( r_e_1_in_a_bus = 1 )
	AND ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_bus_1 ) ) )
	AND ( r_e_1_bus_full = 0 ) )
	AND ( IS_BUS_FULL ( shaft ) ) )
		++ r_e_1_bus_full_yet
		STORE_CAR_CHARACTER_IS_IN ( shaft , r_e_1_bus_1 )
		KILL_ALL_PASSENGERS ( r_e_1_bus_1 )

		IF ( r_e_1_bus_full_yet = 2 )
//		IF ( r_e_1_bus_full_yet < 3 )
//			KILL_ALL_PASSENGERS ( r_e_1_bus_1 )

//		ELSE
			DISPLAY_BRIEF_NOW ( 3403 ) // "Good work, the bus is full. Now bring it up to R.S. and L. BOWS my men will be waiting!"
			UPDATE_DOOR_TARGET ( r_e_1_door_1 , r_e_1_bus_1 )
			MAKE_DOOR_AUTOMATIC ( r_e_1_door_1 )
			POINT_ARROW_AT ( arrow , 184.0 , 31.0 , 2.0 )
			SET r_e_1_bus_full = 1
		ENDIF
	ENDIF


	IF ( ( ( r_e_1_bus_full_yet = 2 ) 
	AND ( r_e_1_bus_1_parking = 0 ) )
	AND ( IS_CAR_IN_BLOCK ( r_e_1_bus_1 , 184.0 , 30.0 , 2.0 , 2.0 , 2.0 ) ) )
//	AND ( LOCATE_CHARACTER_BY_CAR ( shaft , 184.0 , 31.0 , 2.0 , 2.0 , 4.0 ) ) )
//		IF ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_bus_1 ) ) 
			PARK ( r_e_1_bus_1 , r_e_1_door_1 )
