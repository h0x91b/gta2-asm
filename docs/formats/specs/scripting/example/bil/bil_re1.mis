WHILE_EXEC ( r_e_1_bus_delivered = 0 )


	// if car is destroyed the mission is failed
	
	IF ( ( IS_CAR_WRECKED ( r_e_1_truck_1 ) )
	AND ( flag_failed_russ_easy_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3426 ) // "You arsehole! You wrecked the Krishna Bus!"
		SET flag_failed_russ_easy_phone1_m1	= 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN 
	ENDIF
	

	// if player gets in car points at target

   	IF ( ( ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_truck_1 ) )
   	AND ( r_e_1_in_truck_1 = 0 ) )
	AND ( r_e_1_all_groups_in_truck = 0 ) )
//   		DELAY ( 90 )
		SET r_e_1_in_truck_1 = 1
		DISPLAY_BRIEF_NOW ( 3427 ) // "Take the bus across to Maharishi and pick up some Krishnas!"
   		POINT_ARROW_AT ( arrow , 188.5 , 168.0 , 2.0 )
   	ENDIF

	
	// if player gets out of car points back at car and says to get back in
		
   	IF ( ( ( NOT ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_truck_1 ) ) )
	AND ( r_e_1_in_truck_1 = 1 ) )
	AND ( r_e_1_all_groups_in_truck = 0 ) )
//		DELAY ( 90 )
		SET r_e_1_in_truck_1 = 0
		DISPLAY_BRIEF_NOW ( 3402 ) // "What the fuck are you doing! Get your arse back in the Krishna Bus"
		POINT_ARROW_AT ( arrow , r_e_1_truck_1 )
	ENDIF


	// if car is at destination it says to press horn and wait

//	IF ( ( ( IS_CAR_IN_BLOCK ( r_e_1_truck_1 , 8.5 , 83.5 , 2.0 ) ) 
	IF ( ( ( IS_CAR_IN_BLOCK ( r_e_1_truck_1 , 188.5 , 168.0 , 2.0 , 2.0 , 2.0 ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_truck_1 ) ) )
	AND ( r_e_1_press_horn = 0 ) )
		DISPLAY_BRIEF_NOW ( 3428 ) // "Press the horn and wait here"
		SET r_e_1_press_horn = 1
		REMOVE_ARROW ( arrow )
	ENDIF

	
	IF ( ( ( NOT ( IS_CAR_IN_BLOCK ( r_e_1_truck_1 , 188.5 , 168.0 , 2.0 , 2.0 , 2.0 ) ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_truck_1 ) ) )
	AND ( r_e_1_press_horn = 1 ) )
		DISPLAY_BRIEF_NOW ( 3429 ) // "Didn't I tell you to wait there? Get the bus back and pick up the fresh meat!"
		SET r_e_1_press_horn = 0
		POINT_ARROW_AT ( arrow , 188.5 , 168.0 , 2.0 )
	ENDIF


	IF ( ( ( ( NOT ( IS_CAR_IN_BLOCK ( r_e_1_truck_1 , 188.5 , 168.0 , 2.0 , 2.0 , 2.0 ) ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_truck_1 ) ) )
	AND ( r_e_1_pickup_group_4_in_truck = 0 ) )
	AND ( r_e_1_press_horn = 2 ) )
		DISPLAY_BRIEF_NOW ( 3429 ) // "Didn't I tell you to wait there? Get the bus back and pick up the fresh meat!"
		SET r_e_1_press_horn = 3
		POINT_ARROW_AT ( arrow , 188.5 , 168.0 , 2.0 )
	ENDIF

	IF ( ( ( IS_CAR_IN_BLOCK ( r_e_1_truck_1 , 188.5 , 168.0 , 2.0 , 2.0 , 2.0 ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_truck_1 ) ) )
	AND ( r_e_1_press_horn = 3 ) )
	   	SET r_e_1_press_horn = 2
		REMOVE_ARROW ( arrow )
	ENDIF


	// if player presses horn group1 is created and sent to back of car

	IF ( ( ( ( ( IS_CAR_IN_BLOCK ( r_e_1_truck_1 , 188.5 , 168.0 , 2.0 , 2.0 , 2.0 ) ) 
	AND ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_truck_1 ) ) )
	AND ( IS_CHAR_PRESSING_HORN ( shaft ) ) )
	AND ( r_e_1_press_horn = 1 ) )
	AND ( r_e_1_send_pickup_group_1_in_truck = 0 ) )
		REMOVE_ARROW ( arrow )
		SET r_e_1_send_pickup_group_1_in_truck = 1
		SET r_e_1_press_horn = 2
		DISPLAY_BRIEF_NOW ( 3430 ) // "Sit and wait for the braindead Krishnas to get on the bus"
		r_e_1_pickup_group_1_leader = CREATE_CHAR ( 186.0 , 168.0 , 2.0 ) 9 90 criminal END
		SET_CHAR_THREAT_REACTION ( r_e_1_pickup_group_1_leader , no_reaction )
		ADD_CHAR_TO_GANG ( r_e_1_pickup_group_1_leader , krisgang )
		ADD_GROUP_TO_CHARACTER ( r_e_1_pickup_group_1_leader , 4 )
//		SET_CHAR_OBJECTIVE ( r_e_1_pickup_group_1_leader , ENTER_CAR_AS_PASSENGER , r_e_1_truck_1 )
		ORDER_CHAR_TO_BACKDOOR ( r_e_1_pickup_group_1_leader , r_e_1_truck_1 )
	ENDIF


	IF ( ( ( ( ( r_e_1_send_pickup_group_1_in_truck = 1 )
	AND ( NOT ( CHECK_NUMBER_ALIVE_IN_GROUP ( r_e_1_pickup_group_1_leader , 4 ) ) ) )
	AND ( r_e_1_pickup_group_1_leader_dead = 0 ) )
	AND ( r_e_1_send_pickup_group_1_in_truck = 1 ) )
	AND ( flag_failed_kris_med_phone1_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		SET r_e_1_pickup_group_1_leader_dead = 1
		SET flag_failed_kris_med_phone1_m1 = 1
		DISPLAY_BRIEF ( 3431 ) // "You were told to pick them up not kill them, come back when you think you can handle the job!"
		DISPLAY_MESSAGE ( 3732 ) // you have FAILED the mission!"
		RETURN
	ENDIF


	IF ( ( ( ( r_e_1_pickup_group_1_in_truck = 0 ) 
	AND ( r_e_1_send_pickup_group_1_in_truck = 1 ) )
	AND ( IS_GROUP_IN_CAR ( r_e_1_pickup_group_1_leader ) ) )
	AND ( IS_CHAR_OBJECTIVE_PASSED ( r_e_1_pickup_group_1_leader ) ) )
		SET r_e_1_send_pickup_group_1_in_truck = 2
		SET r_e_1_pickup_group_1_in_truck = 1
		SET r_e_1_send_pickup_group_2_in_truck = 1				
		KILL_ALL_PASSENGERS ( r_e_1_truck_1 ) 
		r_e_1_pickup_group_2_leader = CREATE_CHAR ( 191.0 , 168.0 , 2.0 ) 9 90 criminal END
