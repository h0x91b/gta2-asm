   	AND ( r_e_1_in_hotdog_van_1 = 0 ) )
   		SET r_e_1_in_hotdog_van_1 = 1
		DISPLAY_BRIEF ( 3416 ) // "Deliver the van to the diner across town!"
   		POINT_ARROW_AT ( arrow , 13.0 , 120.0 , 2.0 )
   	ENDIF

	
   	IF ( ( NOT ( IS_CHARACTER_IN_CAR ( shaft , r_e_1_hotdog_van_1 ) ) )
	AND ( r_e_1_in_hotdog_van_1 = 1 ) )
		SET r_e_1_in_hotdog_van_1 = 0
		DISPLAY_BRIEF ( 3417 ) // "What the fuck are you doing? Get back into the hot dog van!"
		POINT_ARROW_AT ( arrow , r_e_1_hotdog_van_1 )
	ENDIF
		

	IF ( ( IS_CAR_IN_BLOCK ( r_e_1_hotdog_van_1 , 12.0 , 120.0 , 2.0 , 2.0 , 2.0 ) )
