		SET r_e_1_in_a_bus = 1
		STORE_CAR_CHARACTER_IS_IN ( shaft , r_e_1_bus_1 )
	ENDIF

/*
	IF ( ( ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , bus ) ) )
	AND ( r_e_1_in_a_bus = 1 ) )
	AND ( r_e_1_bus_full = 0 ) )
