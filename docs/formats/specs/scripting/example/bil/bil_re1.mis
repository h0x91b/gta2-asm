ENDWHILE


IF ( flag_passed_russ_easy_phone1_m1 = 0 )  
	CLEAR_ALL_BRIEFS ( )
	DISPLAY_BRIEF ( 3420 ) // "Well done, you have served me and the hungry public well!"
	SET flag_passed_russ_easy_phone1_m1	= 1
	++ counter_all_missions_passed
	DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
	ADD_SCORE ( shaft , 40000 )
	ADD_MULTIPLIER ( shaft , 1 ) 
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( russgang , shaft , 1 )
	CLEAR_WANTED_LEVEL ( shaft )
	SET_PHONE_DEAD ( ph_russ_easy_phone1 ) 
	DISABLE_THREAD_TRIGGER ( thr_russ_easy_phone1_m1 )
	RETURN
ENDIF




