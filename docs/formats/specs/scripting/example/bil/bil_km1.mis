// deletes all objects when Krishna med phone1 mission1 is finished...
				
clean_up_kris_med_phone1_m1: 
	
	SET k_m_1_all_groups_in_truck = 2
	REMOVE_ARROW ( arrow )
	REMOVE_ARROW ( arrow_2 )
	REMOVE_ARROW ( arrow_3 )
	REMOVE_ARROW ( arrow_4 )
	MAKE_DOOR_MANUAL ( k_m_1_door_1 ) 
	
	#ifdef PC
	IF ( k_m_1_alarm_raised_now = 1 )
		DELETE_ITEM ( k_m_1_light_1 )
		DELETE_ITEM ( k_m_1_light_2 )
		DELETE_ITEM ( k_m_1_light_3 )
	ENDIF
	#endif
	
	
	IF ( flag_passed_kris_med_phone1_m1 = 1 )
		++ flag_kris_missions_passed
		++ flag_all_missions_passed
		IF ( flag_kris_missions_passed = 7 )
			DISPLAY_BRIEF ( 3671 ) // "Good work that should stop them building into our community"
			DISPLAY_MESSAGE ( 3670 ) // you have PASSED the mission!"
		ENDIF
	ENDIF

	IF ( flag_failed_kris_med_phone1_m1 = 1 )
		++ flag_kris_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
	ENDIF

	IF ( CHECK_DEATHARREST_EXECUTED ( ) )
		++ flag_kris_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
	ENDIF

	MISSION_HAS_FINISHED ( )
	
	SET flag_on_mission	= 0
	SET flag_on_kris_mission = 0
	
	RETURN


MISSIONSTART

	GOSUB kris_med_phone1_m1:

	GOSUB clean_up_kris_med_phone1_m1:

MISSIONEND



