k_m_1_guard_6 = CREATE_CHAR ( 175.5 , 49.5 , 4.0 )	10 90 criminal END
k_m_1_powerup_1 = CREATE_OBJ ( 227.5 , 133.5 , 3.0 ) 0 COLLECT_01 15 END
k_m_1_powerup_2 = CREATE_OBJ ( 175.5 , 58.5 , 4.0 ) 0 COLLECT_04 15 END
k_m_1_powerup_3 = CREATE_OBJ ( 181.5 , 42.5 , 4.0 ) 0 COLLECT_39 END
k_m_1_powerup_4 = CREATE_OBJ ( 173.5 , 47.5 , 3.0 ) 0 COLLECT_31 END
FORCE_CLEANUP ( k_m_1_powerup_1 )
FORCE_CLEANUP ( k_m_1_powerup_2 )
FORCE_CLEANUP ( k_m_1_powerup_3 )
