ADD_CHAR_TO_GANG ( k_m_1_guard_4 , russgang ) 
ADD_CHAR_TO_GANG ( k_m_1_guard_5 , russgang )
ADD_CHAR_TO_GANG ( k_m_1_guard_6 , russgang )



WHILE_EXEC ( k_m_1_all_groups_in_truck = 0 )

	 
	// if player is seen by guard1
	
	IF ( k_m_1_guards_dead = 0 )
		IF ( ( ( ( HAS_CHAR_SPOTTED_PLAYER ( k_m_1_guard_1 ) ) 
		AND	( IS_CHAR_IN_ZONE ( shaft , B11 ) ) )
		AND ( k_m_1_guard_1_spotted_player = 0 ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			SET k_m_1_guard_1_spotted_player = 1
			SET_CHAR_OBJECTIVE  ( k_m_1_guard_1 , goto_area_on_foot , 168.5 , 44.5 , 2.0 )
			DISPLAY_BRIEF_NOW ( 3240 ) // "shit! we've got an intruder"	 
		ENDIF
	


	// if guard1 gets to alarm all groups kill player, later add if only inside area and not in truck

		IF ( ( ( k_m_1_guard_1_spotted_player = 1 ) 
		AND ( IS_CHAR_OBJECTIVE_PASSED ( k_m_1_guard_1 ) ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			GOSUB k_m_1_alarm_raised:
		ENDIF


	// if player is seen by guard2
	
		IF ( ( ( ( HAS_CHAR_SPOTTED_PLAYER ( k_m_1_guard_2 ) ) 
		AND	( IS_CHAR_IN_ZONE ( shaft , B11 ) ) )
		AND ( k_m_1_guard_2_spotted_player = 0 ) )		
		AND ( k_m_1_alarm_raised_now = 0 ) )
			SET k_m_1_guard_2_spotted_player = 1
			SET_CHAR_OBJECTIVE  ( k_m_1_guard_2 , goto_area_on_foot , 168.5 , 44.5 , 2.0 )
			DISPLAY_BRIEF_NOW ( 3240 ) // "shit! we've got an intruder"	 
		ENDIF


		// if guard2 gets to alarm all groups kill player, later add if only inside area and not in truck

		IF ( ( ( k_m_1_guard_2_spotted_player = 1 ) 
		AND ( IS_CHAR_OBJECTIVE_PASSED ( k_m_1_guard_2 ) ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			GOSUB k_m_1_alarm_raised:
		ENDIF


		// if player is seen by guard3
		
		IF ( ( ( ( HAS_CHAR_SPOTTED_PLAYER ( k_m_1_guard_3 ) ) 
		AND	( IS_CHAR_IN_ZONE ( shaft , B11 ) ) )
		AND ( k_m_1_guard_3_spotted_player = 0 ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			SET k_m_1_guard_3_spotted_player = 1
			SET_CHAR_OBJECTIVE  ( k_m_1_guard_3 , goto_area_on_foot , 166.5 , 38.5 , 2.0 )
			DISPLAY_BRIEF_NOW ( 3240 ) // "shit! we've got an intruder"	 
		ENDIF


		// if guard3 gets to alarm all groups kill player, later add if only inside area and not in truck

		IF ( ( ( k_m_1_guard_3_spotted_player = 1 ) 
		AND ( IS_CHAR_OBJECTIVE_PASSED ( k_m_1_guard_3 ) ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			GOSUB k_m_1_alarm_raised:
		ENDIF


		// if player is seen by guard4
		
		IF ( ( ( ( HAS_CHAR_SPOTTED_PLAYER ( k_m_1_guard_4 ) ) 
		AND	( IS_CHAR_IN_ZONE ( shaft , B11 ) ) )
		AND ( k_m_1_guard_4_spotted_player = 0 ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			SET k_m_1_guard_4_spotted_player = 1
			SET_CHAR_OBJECTIVE  ( k_m_1_guard_4 , goto_area_on_foot , 180.5 , 43.5 , 2.0 )
			DISPLAY_BRIEF_NOW ( 3240 ) // "shit! we've got an intruder"	 
		ENDIF


		// if guard4 gets to alarm all groups kill player, later add if only inside area and not in truck

		IF ( ( ( k_m_1_guard_4_spotted_player = 1 ) 
		AND ( IS_CHAR_OBJECTIVE_PASSED ( k_m_1_guard_4 ) ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			GOSUB k_m_1_alarm_raised:
		ENDIF


		// if player is seen by guard5
		
		IF ( ( ( ( HAS_CHAR_SPOTTED_PLAYER ( k_m_1_guard_5 ) ) 
		AND	( IS_CHAR_IN_ZONE ( shaft , B11 ) ) )
		AND ( k_m_1_guard_5_spotted_player = 0 ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			SET k_m_1_guard_5_spotted_player = 1
			SET_CHAR_OBJECTIVE  ( k_m_1_guard_5 , goto_area_on_foot , 180.5 , 43.5 , 2.0 )
			DISPLAY_BRIEF_NOW ( 3240 ) // "shit! we've got an intruder"	 
		ENDIF


		// if guard5 gets to alarm all groups kill player, later add if only inside area and not in truck

		IF ( ( ( k_m_1_guard_5_spotted_player = 1 ) 
		AND ( IS_CHAR_OBJECTIVE_PASSED ( k_m_1_guard_5 ) ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			GOSUB k_m_1_alarm_raised:
		ENDIF


		// if player is seen by guard6
		
		IF ( ( ( ( HAS_CHAR_SPOTTED_PLAYER ( k_m_1_guard_6 ) ) 
		AND	( IS_CHAR_IN_ZONE ( shaft , B11 ) ) )
		AND ( k_m_1_guard_6_spotted_player = 0 ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			SET k_m_1_guard_6_spotted_player = 1
			SET_CHAR_OBJECTIVE  ( k_m_1_guard_6 , goto_area_on_foot , 168.5 , 44.5 , 2.0 )
			DISPLAY_BRIEF_NOW ( 3240 ) // "shit! we've got an intruder"	 
		ENDIF


		// if guard6 gets to alarm all groups kill player, later add if only inside area and not in truck

		IF ( ( ( k_m_1_guard_6_spotted_player = 1 ) 
		AND ( IS_CHAR_OBJECTIVE_PASSED ( k_m_1_guard_6 ) ) )
		AND ( k_m_1_alarm_raised_now = 0 ) )
			GOSUB k_m_1_alarm_raised:
		ENDIF
	ENDIF


	// if car is destroyed the mission is failed
	
	IF ( ( IS_CAR_WRECKED ( k_m_1_truck_1 ) )
	AND ( flag_failed_kris_med_phone1_m1 = 0 ) )
//		DELAY_HERE ( 90 )
		SET flag_failed_kris_med_phone1_m1 = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3242 ) // "you can't pick anybody up without the truck, you have failed me!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF
	

	// if player gets in car points at target

   	IF ( ( IS_CHARACTER_IN_CAR ( shaft , k_m_1_truck_1 ) )
   	AND ( k_m_1_in_truck_1 = 0 ) )
//   		DELAY ( 90 )
		SET k_m_1_in_truck_1 = 1
		DISPLAY_BRIEF_NOW ( 3243 ) // "get the truck across to the dockside near Mad Island!"
   		POINT_ARROW_AT ( arrow , 8.5 , 83.5 , 2.0 )
   	ENDIF

	
	// if player gets out of car points back at car and says to get back in
		
   	IF ( ( NOT ( IS_CHARACTER_IN_CAR ( shaft , k_m_1_truck_1 ) ) )
	AND ( k_m_1_in_truck_1 = 1 ) )
//		DELAY ( 90 )
		SET k_m_1_in_truck_1 = 0
		DISPLAY_BRIEF_NOW ( 3244 ) // "what the fuck are you doing! get your arse back in the truck"
		POINT_ARROW_AT ( arrow , k_m_1_truck_1 )
	ENDIF


	// if car is at destination it says to press horn and wait

//	IF ( ( ( IS_CAR_IN_BLOCK ( k_m_1_truck_1 , 8.5 , 83.5 , 2.0 ) ) 
	IF ( ( ( IS_CAR_IN_BLOCK ( k_m_1_truck_1 , 8.5 , 83.5 , 2.0 , 2.0 , 2.0 ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , k_m_1_truck_1 ) ) )
	AND ( k_m_1_press_horn = 0 ) )
		DISPLAY_BRIEF_NOW ( 3245 ) // "press the horn and wait here"
		SET k_m_1_press_horn = 1
		REMOVE_ARROW ( arrow )
	ENDIF

	
	IF ( ( ( NOT ( IS_CAR_IN_BLOCK ( k_m_1_truck_1 , 8.5 , 83.5 , 2.0 , 2.0 , 2.0 ) ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , k_m_1_truck_1 ) ) )
	AND ( k_m_1_press_horn = 1 ) )
		DISPLAY_BRIEF_NOW ( 3254 ) // "Didn't I tell you to wait there? Get the truck back to  "
		SET k_m_1_press_horn = 0
		POINT_ARROW_AT ( arrow , 8.5 , 83.5 , 2.0 )
	ENDIF


	IF ( ( ( ( NOT ( IS_CAR_IN_BLOCK ( k_m_1_truck_1 , 8.5 , 83.5 , 2.0 , 2.0 , 2.0 ) ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , k_m_1_truck_1 ) ) )
	AND ( k_m_1_pickup_group_4_in_truck = 0 ) )
	AND ( k_m_1_press_horn = 2 ) )
		DISPLAY_BRIEF_NOW ( 3254 ) // "Didn't I tell you to wait there? Get the truck back to  "
		SET k_m_1_press_horn = 3
		POINT_ARROW_AT ( arrow , 8.5 , 83.5 , 2.0 )
	ENDIF

	IF ( ( ( IS_CAR_IN_BLOCK ( k_m_1_truck_1 , 8.5 , 83.5 , 2.0 , 2.0 , 2.0 ) )
	AND ( IS_CHARACTER_IN_CAR ( shaft , k_m_1_truck_1 ) ) )
	AND ( k_m_1_press_horn = 3 ) )
	   	SET k_m_1_press_horn = 2
		REMOVE_ARROW ( arrow )
	ENDIF


	// if player presses horn group1 is created and sent to back of car

	IF ( ( ( ( ( IS_CAR_IN_BLOCK ( k_m_1_truck_1 , 8.5 , 83.5 , 2.0 , 2.0 , 2.0 ) ) 
	AND ( IS_CHARACTER_IN_CAR ( shaft , k_m_1_truck_1 ) ) )
	AND ( IS_CHAR_PRESSING_HORN ( shaft ) ) )
	AND ( k_m_1_press_horn = 1 ) )
	AND ( k_m_1_send_pickup_group_1_in_truck = 0 ) )
		REMOVE_ARROW ( arrow )
		SET k_m_1_send_pickup_group_1_in_truck = 1
		SET k_m_1_press_horn = 2
		DISPLAY_BRIEF_NOW ( 3246 ) // "sit and wait for the stupid russians to get into the truck"
		#ifdef PSX
		DELETE_ITEM ( k_m_1_guard_1 )
		DELETE_ITEM ( k_m_1_guard_2 )
		DELETE_ITEM ( k_m_1_guard_3 )
		DELETE_ITEM ( k_m_1_guard_4 )
		DELETE_ITEM ( k_m_1_guard_5 )
		DELETE_ITEM ( k_m_1_guard_6 )
		DELETE_ITEM ( k_m_1_group_1_leader )
		DELETE_ITEM ( k_m_1_group_2_leader )
		DELETE_ITEM ( k_m_1_group_3_leader )
		SET k_m_1_guards_dead = 1
		#endif
		k_m_1_pickup_group_1_leader = CREATE_CHAR ( 6.5 , 81.7 , 2.0 ) 10 90 criminal END
