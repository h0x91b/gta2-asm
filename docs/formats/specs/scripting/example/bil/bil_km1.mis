k_m_1_alarm_raised:
	
	SET_CHAR_OBJECTIVE  ( k_m_1_guard_1 , kill_char_on_foot , shaft )
	SET_CHAR_OBJECTIVE  ( k_m_1_guard_2 , kill_char_on_foot , shaft )
	SET_CHAR_OBJECTIVE  ( k_m_1_guard_3 , kill_char_on_foot , shaft )
	SET_CHAR_OBJECTIVE  ( k_m_1_guard_4 , kill_char_on_foot , shaft )
	SET_CHAR_OBJECTIVE  ( k_m_1_guard_5 , kill_char_on_foot , shaft )
	SET_CHAR_OBJECTIVE  ( k_m_1_guard_6 , kill_char_on_foot , shaft )
	#ifdef PC
	k_m_1_light_1 = CREATE_LIGHT ( 166.0 , 40.0 , 3.0 ) 7.9 255 ( 255 , 0 , 0 ) 30 90 0
	k_m_1_light_2 = CREATE_LIGHT ( 171.0 , 48.0 , 3.0 ) 7.9 255 ( 255 , 0 , 0 ) 30 90 0
	k_m_1_light_3 = CREATE_LIGHT ( 180.0 , 44.0 , 3.0 ) 7.9 255 ( 255 , 0 , 0 ) 30 90 0

	DELAY_HERE ( 90 )
	k_m_1_alarm_1 = CREATE_SOUND ( 166.0 , 40.0 , 6.0 ) prison_alarm play_forever END
	k_m_1_alarm_2 = CREATE_SOUND ( 171.0 , 48.0 , 6.0 ) prison_alarm play_forever END
	k_m_1_alarm_3 = CREATE_SOUND ( 180.0 , 44.0 , 6.0 ) prison_alarm play_forever END
	FORCE_CLEANUP ( k_m_1_alarm_1 )
	FORCE_CLEANUP ( k_m_1_alarm_2 )
	FORCE_CLEANUP ( k_m_1_alarm_3 )
	#endif
	SET k_m_1_alarm_raised_now = 1
	DISPLAY_BRIEF ( 3241 ) // "INTRUDER ALERT! INTRUDER ALERT!"
	k_m_1_group_1_leader = CREATE_CHAR ( 165.5 , 41.5 , 2.0 ) 10 90 criminal END
	k_m_1_group_2_leader = CREATE_CHAR ( 169.5 , 45.5 , 2.0 ) 10 90 criminal END
	k_m_1_group_3_leader = CREATE_CHAR ( 179.5 , 44.5 , 2.0 ) 10 90 criminal END
	SET_CHAR_THREAT_REACTION ( k_m_1_group_1_leader , no_reaction )
	SET_CHAR_THREAT_REACTION ( k_m_1_group_2_leader , no_reaction )
	SET_CHAR_THREAT_REACTION ( k_m_1_group_3_leader , no_reaction )
    GIVE_WEAPON ( k_m_1_group_1_leader , pistol )
	GIVE_WEAPON ( k_m_1_group_2_leader , dual_pistol )
	GIVE_WEAPON ( k_m_1_group_3_leader , shotgun )
	#ifdef PSX
	GIVE_WEAPON ( k_m_1_group_1_leader , shotgun )
	GIVE_WEAPON ( k_m_1_group_2_leader , shotgun )
	GIVE_WEAPON ( k_m_1_group_3_leader , shotgun )
	#endif
	ADD_CHAR_TO_GANG ( k_m_1_group_1_leader , russgang )
	ADD_CHAR_TO_GANG ( k_m_1_group_2_leader , russgang )
	ADD_CHAR_TO_GANG ( k_m_1_group_3_leader , russgang )	
	#ifdef PC
	ADD_GROUP_TO_CHARACTER ( k_m_1_group_1_leader , 4 )
	ADD_GROUP_TO_CHARACTER ( k_m_1_group_2_leader , 4 )
	ADD_GROUP_TO_CHARACTER ( k_m_1_group_3_leader , 4 )
	#endif
	#ifdef PSX
	ADD_GROUP_TO_CHARACTER ( k_m_1_group_1_leader , 1 )
	#endif
	SET_CHAR_OBJECTIVE  ( k_m_1_group_1_leader , kill_char_on_foot , shaft )
	SET_CHAR_OBJECTIVE  ( k_m_1_group_2_leader , kill_char_on_foot , shaft )
	SET_CHAR_OBJECTIVE  ( k_m_1_group_3_leader , kill_char_on_foot , shaft )
RETURN

				
