// starts Krishna med phone1 mission1
					

kris_med_phone1_m1:

SET flag_failed_kris_med_phone1_m1 = 0


//DISABLE_THREAD_TRIGGER ( thr_kris_med_phone1_m1 ) 
DISPLAY_MESSAGE ( 3842 ) // you have PASSED the mission!"
DISPLAY_BRIEF ( 3252 ) // "you have selected Krishna med phone1 mission1"
SET flag_on_mission = 1
SET flag_on_kris_mission = 1
k_m_1_truck_1 = CREATE_CAR ( 165.0 , 43.5 , 2.0 )	1 90 boxtruck END
POINT_ARROW_AT ( arrow , k_m_1_truck_1 )
UPDATE_DOOR_TARGET ( k_m_1_door_1 , k_m_1_truck_1 ) 

k_m_1_guard_1 = CREATE_CHAR ( 166.5 , 40.5 , 2.0 )	10 90 criminal END
k_m_1_guard_2 = CREATE_CHAR ( 174.5 , 44.5 , 2.0 )	10 90 criminal END
k_m_1_guard_3 = CREATE_CHAR ( 171.5 , 37.5 , 2.0 )	10 90 criminal END
