		z_m_2_yeeha = CREATE_SOUND ( 33.8 , 58.0 , 6.0 ) yeeha_bomb play_instant END
		FORCE_CLEANUP ( z_m_2_yeeha )
		#endif
	ENDIF

	IF ( ( z_m_2_locksmith_1_obj1_passed = 2 ) 
	AND ( NOT ( DELAY ( 60 ) ) ) ) 
		SET_CHAR_OBJECTIVE ( z_m_2_locksmith_1 , goto_area_on_foot , 37.0 , 53.2 , 2.0 )
//	   	POINT_ARROW_AT ( arrow , 37.0 , 53.0 , 2.0 )	
		SET z_m_2_locksmith_1_obj1_passed = 3
	ENDIF

	IF ( ( ( IS_CHAR_OBJECTIVE_PASSED ( z_m_2_locksmith_1 ) ) 
