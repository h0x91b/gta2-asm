	ENDIF
	
ENDWHILE


DISPLAY_BRIEF ( 3925 ) // "this had better be good i just spent 100 dollars and didn't get to finish the job!"
MAKE_NEW_LEADER_OF_GROUP ( z_m_2_locksmith_1 , shaft )
POINT_ARROW_AT ( arrow , 34.0 , 58.0 , 2.0 )


WHILE_EXEC ( z_m_2_locksmith_1_at_door = 0 )


	// if truck is destroyed the mission is failed
	
	
	IF ( ( LOCATE_CHARACTER_ON_FOOT ( shaft , 34.0 , 58.0 , 2.0 , 4.0 , 2.0  ) )
	AND ( NOT ( IS_CHARACTER_IN_ANY_CAR ( z_m_2_locksmith_1	) ) ) )
		SET z_m_2_locksmith_1_at_door = 1
	ENDIF

	
	IF ( ( IS_CAR_WRECKED ( z_m_2_truck_1 ) )
