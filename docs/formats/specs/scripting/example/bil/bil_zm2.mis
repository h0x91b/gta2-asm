		DISPLAY_BRIEF_NOW ( 3952 ) // "Where the fuck is the guy? Have you taken off without him? Go and find him now!"
	ENDIF


	IF ( ( IS_ITEM_ACCURATELY_ONSCREEN ( z_m_2_locksmith_1 ) )
	AND ( z_m_2_locksmith_1_on_screen_2 = 1 ) )
		POINT_ARROW_AT ( arrow , 34.0 , 58.0 , 2.0 )
		SET z_m_2_locksmith_1_on_screen_2 = 0
		DISPLAY_BRIEF_NOW ( 3953 ) // "Why did you leave me behind? I'm helping YOU! Take me to the locked door!"
	ENDIF	
	
ENDWHILE


REMOVE_CHAR_FROM_GROUP ( shaft , z_m_2_locksmith_1 )			
SET_CHAR_OBJECTIVE ( z_m_2_locksmith_1 , goto_area_on_foot , 33.8 , 58.0 , 2.0 ) 
