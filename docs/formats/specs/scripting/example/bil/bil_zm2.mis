WHILE_EXEC ( z_m_2_locksmith_1_dead = 0 )

		
	// if truck is destroyed the mission is failed
	
	IF ( ( IS_CAR_WRECKED ( z_m_2_truck_1 ) )
	AND ( flag_failed_zaib_med_phone2_m1 = 0 ) )
		SET flag_failed_zaib_med_phone2_m1 = 1
