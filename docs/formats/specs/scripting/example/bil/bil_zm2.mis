		z_m_2_tick = CREATE_SOUND ( 33.8 , 58.0 , 6.0 ) bomb_tick play_forever END
		FORCE_CLEANUP ( z_m_2_tick )
		#endif
	ENDIF

	IF ( ( z_m_2_locksmith_1_obj1_passed = 1 ) 
	AND ( NOT ( DELAY ( 60 ) ) ) ) 
		OPEN_DOOR ( z_m_2_door_1_1 )
		#ifdef PC
		DELETE_ITEM ( z_m_2_tick )
		OPEN_DOOR ( z_m_2_door_1_2 )
		#endif
		DISPLAY_BRIEF_NOW ( 3927 ) // "no problem, this is fucking easy, i can bypass any security system!"
		SET z_m_2_locksmith_1_obj1_passed = 2
