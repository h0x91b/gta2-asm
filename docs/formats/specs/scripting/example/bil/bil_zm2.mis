	ENDIF

	// if player is seen by guard3
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_2_guard_3 ) ) 
   	AND ( z_m_2_guard_3_spotted_player = 0 ) )
		SET z_m_2_guard_3_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3937 ) // "Who the fuck are you! Die motherfucker!"	 
	ENDIF

	// if player is seen by guard4
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_2_guard_4 ) ) 
   	AND ( z_m_2_guard_4_spotted_player = 0 ) )
		SET z_m_2_guard_4_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3938 ) // "Who the fuck are you! Die motherfucker!"	 
	ENDIF

	// if player is seen by guard5
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_2_guard_5 ) ) 
   	AND ( z_m_2_guard_5_spotted_player = 0 ) )
		SET z_m_2_guard_5_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3939 ) // "Who the fuck are you! Die motherfucker!"	 
	ENDIF


	IF ( ( ( IS_CHARACTER_IN_CAR ( shaft , z_m_2_truck_1 ) )
	AND ( z_m_2_player_been_in_truck_1 = 0 ) )
	AND ( z_m_2_generator_destroyed < 2 ) )
		SET z_m_2_player_been_in_truck_1 = 1
		DISPLAY_BRIEF_NOW ( 3940 ) // "What took you so long, get the truck back to the hideout!"
		POINT_ARROW_AT ( arrow , 28.0 , 37.0 , 3.0 )
	ENDIF

	
	IF ( ( ( ( LOCATE_CHARACTER_BY_CAR ( shaft , 28.0 , 37.0 , 3.0 , 2.0 , 2.0  ) ) 
	AND ( IS_CHARACTER_IN_CAR ( shaft , z_m_2_truck_1 ) ) )
	AND ( z_m_2_player_been_in_truck_1 = 1 ) )
	AND ( z_m_2_generator_destroyed < 2 ) )
		SET z_m_2_player_been_in_truck_1 = 2
		DISPLAY_BRIEF_NOW ( 3941 ) // "Every fucking door in this shithole is locked! Try taking out the generators above the door!" 
	ENDIF


	IF ( ( CHECK_OBJ_MODEL ( z_m_2_generator_2 , powergen_dead ) )
	AND ( z_m_2_generator_destroyed = 0 ) )
		++ z_m_2_generator_destroyed 
		DISPLAY_BRIEF_NOW ( 3944 ) // "That's one of them destroyed, now take out the other one!"
	ENDIF

	IF ( ( CHECK_OBJ_MODEL ( z_m_2_generator_1 , powergen_dead ) )
	AND ( z_m_2_generator_destroyed = 0 ) )
		++ z_m_2_generator_destroyed 
		DISPLAY_BRIEF_NOW ( 3944 ) // "That's one of them destroyed, now take out the other one!"
	ENDIF
	
	IF ( ( CHECK_OBJ_MODEL ( z_m_2_generator_2 , powergen_dead ) )
	AND ( z_m_2_generator_destroyed_brief_2 = 0 ) )
		SET z_m_2_generator_destroyed_brief_2 = 1
		#ifdef PC
		DELETE_ITEM ( z_m_2_generator_2_sound )
		#endif
	ENDIF

	IF ( ( CHECK_OBJ_MODEL ( z_m_2_generator_1 , powergen_dead ) )
	AND ( z_m_2_generator_destroyed_brief_1 = 0 ) )
		SET z_m_2_generator_destroyed_brief_1 = 1 
		#ifdef PC
		DELETE_ITEM ( z_m_2_generator_1_sound )
		#endif
	ENDIF


	IF ( ( ( z_m_2_generator_destroyed = 1 )
	AND ( CHECK_OBJ_MODEL ( z_m_2_generator_1 , powergen_dead ) ) )
	AND ( CHECK_OBJ_MODEL ( z_m_2_generator_2 , powergen_dead ) ) )
		SET z_m_2_generator_destroyed = 2
		DISPLAY_BRIEF ( 3942 ) // "Great work, the doors should be open get the truck back here, and watch your back!"
		OPEN_DOOR ( z_m_2_door_3_1 )
		OPEN_DOOR ( z_m_2_door_3_2 )
		POINT_ARROW_AT ( arrow , z_m_2_truck_1 )
	ENDIF


	IF ( ( IS_CHARACTER_IN_CAR ( shaft , z_m_2_truck_1 ) )
	AND ( z_m_2_generator_destroyed = 2 ) )
		SET z_m_2_generators_destroyed = 1
	ENDIF

	// if truck is destroyed the mission is failed
	
	IF ( ( IS_CAR_WRECKED ( z_m_2_truck_1 ) )
	AND ( flag_failed_zaib_med_phone2_m1 = 0 ) )
		SET flag_failed_zaib_med_phone2_m1 = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3947 ) // "Shit, what the fuck happened to the truck? We needed it to put a stop to them working outside of their area! Mission Failed!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF


ENDWHILE


z_m_2_chase_guard_1 = CREATE_CHAR ( 23.5 , 75.5 , 2.0 ) 10 90 criminal END
ADD_CHAR_TO_GANG ( z_m_2_chase_guard_1 , russgang )
SET_CHAR_OBJECTIVE ( z_m_2_chase_guard_1 , kill_char_any_means , shaft ) 
SET_CHAR_THREAT_SEARCH ( z_m_2_chase_guard_1 , line_of_sight_player_only )
SET_CHAR_THREAT_REACTION ( z_m_2_chase_guard_1 , no_reaction )
GIVE_WEAPON ( z_m_2_chase_guard_1 , machine_gun )
z_m_2_chase_guard_2 = CREATE_CHAR ( 23.5 , 76.5 , 2.0 ) 10 90 criminal END
ADD_CHAR_TO_GANG ( z_m_2_chase_guard_2 , russgang )
SET_CHAR_OBJECTIVE ( z_m_2_chase_guard_2 , kill_char_any_means , shaft ) 
SET_CHAR_THREAT_SEARCH ( z_m_2_chase_guard_2 , line_of_sight_player_only )
SET_CHAR_THREAT_REACTION ( z_m_2_chase_guard_2 , no_reaction )
GIVE_WEAPON ( z_m_2_chase_guard_2 , machine_gun )

	
WHILE_EXEC ( z_m_2_truck_1_parked = 0 )


	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_2_chase_guard_1 ) ) 
   	AND ( z_m_2_chase_guard_1_spotted_player = 0 ) )
		SET z_m_2_chase_guard_1_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3945 ) // "Nobody steals from us, you're gonna die slow!"	 
	ENDIF
	
	IF ( ( HAS_CHAR_SPOTTED_PLAYER ( z_m_2_chase_guard_2 ) ) 
   	AND ( z_m_2_chase_guard_2_spotted_player = 0 ) )
		SET z_m_2_chase_guard_2_spotted_player = 1
		DISPLAY_BRIEF_NOW ( 3946 ) // "I'm going to enjoy keeling you motherbeetch!"	 
	ENDIF	

   
	// if truck is destroyed the mission is failed
	
	IF ( ( IS_CAR_WRECKED ( z_m_2_truck_1 ) )
	AND ( flag_failed_zaib_med_phone2_m1 = 0 ) )
		SET flag_failed_zaib_med_phone2_m1 = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3947 ) // "Shit, what the fuck happened to the truck? We needed it to put a stop to them working outside of their area! Mission Failed!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF

		
 	// if player gets in truck points at target

   	IF ( ( IS_CHARACTER_IN_CAR ( shaft , z_m_2_truck_1 ) )
   	AND ( z_m_2_in_truck_1 = 0 ) )
		SET z_m_2_in_truck_1 = 1
		DISPLAY_BRIEF_NOW ( 3943 ) // "Stop fucking around, get the truck back to the hideout!"
		POINT_ARROW_AT ( arrow , 56.0 , 174.0 , 1.0 )
   	ENDIF

	
	// if player gets out of truck points back at truck and says to get back in
		
   	IF ( ( NOT ( IS_CHARACTER_IN_CAR ( shaft , z_m_2_truck_1 ) ) )
	AND ( z_m_2_in_truck_1 = 1 ) )
		SET z_m_2_in_truck_1 = 0
		DISPLAY_BRIEF_NOW ( 3949 ) // "what the fuck are you doing! get your arse back in the truck"
		POINT_ARROW_AT ( arrow , z_m_2_truck_1 )
	ENDIF


	// waits for player outside door, then parks the truck
	
//	IF ( ( ( LOCATE_CHARACTER_BY_CAR ( shaft , 56.0 , 175.0 , 2.0 , 2.0 , 2.0 ) ) 
//	AND ( IS_CHARACTER_IN_CAR ( shaft , z_m_2_truck_1 ) ) )
	IF ( ( IS_CAR_IN_BLOCK ( z_m_2_truck_1 , 56.0 , 175.0 , 2.0 , 2.0 , 2.0 ) )
	AND ( z_m_2_in_truck_1_parking = 0 ) )
		PARK ( z_m_2_truck_1 , z_m_2_door_4 )
		SET z_m_2_in_truck_1_parking = 1
	ENDIF	


	// waits for truck to finish parking, then passes mission
	
	IF ( ( z_m_2_in_truck_1_parking = 1	)
	AND ( HAS_PARK_FINISHED ( ) ) )
		SET flag_passed_zaib_med_phone2_m1 = 1
		SET z_m_2_truck_1_parked = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3950 ) // "Well done, those Russian fuckers will think again before trying to expand their territory!"
		++ counter_all_missions_passed
		DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
		ADD_SCORE ( shaft , 60000 )
		ADD_MULTIPLIER ( shaft , 1 )
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( zaibgang , shaft , 1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
		IF ( flag_passed_zaib_med_phone1_2_m3 = 1 )
			SET_PHONE_DEAD ( ph_zaib_med_phone2 ) 
			DISABLE_THREAD_TRIGGER ( thr_zaib_med_phone2_m1 )
		ENDIF
		RETURN
	ENDIF

ENDWHILE
	




	


			  

	 

//------------------------------------------------------------------------------------------
