WHILE_EXEC ( z_m_2_door_2_open = 0 )


	// if truck is destroyed the mission is failed
	
	IF ( ( IS_CAR_WRECKED ( z_m_2_truck_1 ) )
	AND ( flag_failed_zaib_med_phone2_m1 = 0 ) )
		SET flag_failed_zaib_med_phone2_m1 = 1
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3947 ) // "Shit, what the fuck happened to the truck? We needed it to put a stop to them working outside of their area! Mission Failed!"
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF
	
	
	IF ( ( LOCATE_CHARACTER_BY_CAR ( shaft , 37.0 , 53.0 , 2.0 , 4.0 , 2.0  ) ) 
	AND ( IS_CHARACTER_IN_MODEL ( shaft , buick ) )	)
		SET z_m_2_door_2_open = 1 
	ELSE

		IF ( ( ( IS_CHARACTER_IN_ANY_CAR ( shaft ) ) 
		AND ( LOCATE_CHARACTER_BY_CAR ( shaft , 37.0 , 53.0 , 2.0 , 4.0 , 2.0  ) ) )
		AND ( z_m_2_in_wrong_car_at_door_2 = 0 ) )
			DISPLAY_BRIEF_NOW ( 3933 ) // "You need a gang car dickhead, they won't let you in unless they think you're one of them!"
			SET z_m_2_in_wrong_car_at_door_2 = 1
		ENDIF

	ENDIF


	IF ( ( NOT ( IS_CHARACTER_IN_ANY_CAR ( shaft ) ) )
	AND ( z_m_2_in_wrong_car_at_door_2 = 1 ) )
		SET z_m_2_in_wrong_car_at_door_2 = 0
	ENDIF


	IF ( ( IS_CHARACTER_IN_MODEL ( shaft , buick ) )
	AND ( z_m_2_in_gang_car = 0 ) )
		DISPLAY_BRIEF_NOW ( 3931 ) // "Good work, get moving back up to the door and see if they fall for it!"
		POINT_ARROW_AT ( arrow , 37.0 , 53.0 , 2.0 )
		SET z_m_2_in_gang_car = 1
	ENDIF


	IF ( ( NOT ( IS_CHARACTER_IN_MODEL ( shaft , buick ) ) )
	AND ( z_m_2_in_gang_car = 1 ) )
		DISPLAY_BRIEF_NOW ( 3932 ) // "Shit, what are you doing get your ass back into a Russian gang car!"
