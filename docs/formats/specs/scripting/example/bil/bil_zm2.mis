		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF
	
	
  	IF ( ( IS_CHAR_OBJECTIVE_PASSED ( z_m_2_locksmith_1 ) ) 
	AND ( z_m_2_locksmith_1_obj1_passed = 0 ) )
