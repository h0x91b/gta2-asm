// deletes all objects when Zaibatsu med phone2 mission1 is finished...
				
clean_up_zaib_med_phone2_m1: 
	
	REMOVE_ARROW ( arrow )
	REMOVE_ARROW ( arrow_2 )
	REMOVE_ARROW ( arrow_3 )
	REMOVE_ARROW ( arrow_4 )
	OPEN_DOOR ( z_m_2_door_1_1 )
	OPEN_DOOR ( z_m_2_door_2_1 )
	OPEN_DOOR ( z_m_2_door_3_1 )
	OPEN_DOOR ( z_m_2_door_3_2 )
	
	#ifdef PC
	OPEN_DOOR ( z_m_2_door_1_2 )
	OPEN_DOOR ( z_m_2_door_2_2 )
	#endif
	MAKE_DOOR_MANUAL ( z_m_2_door_4 ) 
	
	
	IF ( flag_passed_zaib_med_phone2_m1 = 1 )
		++ flag_zaib_missions_passed
		++ flag_all_missions_passed
		IF ( flag_zaib_missions_passed = 7 )
			DISPLAY_BRIEF ( 3675 ) // "Good work that should stop them building into our community"
			DISPLAY_MESSAGE ( 3674 ) // you have PASSED the mission!"
		ENDIF
	ENDIF

	IF ( flag_failed_zaib_med_phone2_m1 = 1 )
		++ flag_zaib_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( zaibgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
	ENDIF

	IF ( CHECK_DEATHARREST_EXECUTED ( ) )
		++ flag_zaib_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( zaibgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
	ENDIF

	MISSION_HAS_FINISHED ( )
	
	SET flag_on_mission	= 0
	SET flag_on_zaib_mission = 0
	
	RETURN


MISSIONSTART

	GOSUB zaib_med_phone2_m1:

	GOSUB clean_up_zaib_med_phone2_m1:

MISSIONEND



