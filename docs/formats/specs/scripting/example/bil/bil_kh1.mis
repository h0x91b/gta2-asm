		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3296 ) // "Shit the limo has been destroyed, I needed them both!"
		SET flag_failed_kris_hard_phone_m1 = 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF


	// if the limo_2 is destroyed the mission is failed
	
	IF ( ( IS_CAR_WRECKED ( k_h_1_limo_2 ) )
	AND ( flag_failed_kris_hard_phone_m1 = 0 ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3296 ) // "You were supposed to follow my men in that! You have failed me!"
		SET flag_failed_kris_hard_phone_m1 = 1
		DISPLAY_MESSAGE ( 3730 ) // you have FAILED the mission!"
		RETURN
	ENDIF
	
	
	IF ( ( k_h_1_archie_leader_1_obj14_passed = 0 )
	AND ( IS_CHAR_OBJECTIVE_PASSED ( k_h_1_archie_leader_1 ) ) )
		CLEAR_ALL_BRIEFS ( )
		DISPLAY_BRIEF ( 3303 ) // "Nice working with you!"
		SET_CHAR_OBJECTIVE  ( k_h_1_archie_leader_1 , goto_area_on_foot , 231.5 , 113.0 , 2.0 )
		SET_CHAR_THREAT_REACTION ( k_h_1_archie_leader_1 , no_reaction )
		POINT_ARROW_AT ( arrow , k_h_1_archie_leader_1 )
		SET k_h_1_archie_leader_1_obj14_passed = 1
	ENDIF

	
	IF ( ( IS_CHAR_OBJECTIVE_PASSED ( k_h_1_archie_leader_1 ) ) 
	AND ( k_h_1_archie_leader_1_obj14_passed = 1 ) )
		SET k_h_1_archie_leader_1_obj14_passed = 2	
		SET_CHAR_OBJECTIVE  ( k_h_1_archie_leader_1 , wait_on_foot )
		SET k_h_1_archie_leader_1_safe = 1
	ENDIF

		
ENDWHILE


IF ( ( k_h_1_archie_leader_1_safe = 1 )
AND ( flag_passed_kris_hard_phone_m1 = 0 ) )
	SET flag_passed_kris_hard_phone_m1	= 1
	DISPLAY_BRIEF_NOW ( 3304 ) // "Good work, my men and my limos are safe!"
	++ counter_all_missions_passed
	DISPLAY_MESSAGE ( 3100 ) // you have PASSED the mission!"
	ADD_SCORE ( shaft , 80000 )
	ADD_MULTIPLIER ( shaft , 1 )
	CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , 1 ) 
	CLEAR_WANTED_LEVEL ( shaft )
	RETURN
ENDIF



	

//------------------------------------------------------------------------------------------
//------------------------------------------------------------------------------------------



// deletes all objects when Krishna hard phone mission1 is finished...
				
clean_up_kris_hard_phone_m1: 
	
	REMOVE_ARROW ( arrow )
	REMOVE_ARROW ( arrow_2 )
	REMOVE_ARROW ( arrow_3 )
	REMOVE_ARROW ( arrow_4 )
	OPEN_DOOR ( k_h_1_door_2 )

  	SET_CAR_DENSITY ( cityinfo , 600 ) 
	SET_PEDDENSITY ( cityinfo , 600 )

	SET_CAR_DENSITY ( m01 , 400 ) 
	SET_PEDDENSITY ( m01 , 600 )

	SET_CAR_DENSITY ( m02 , 400 ) 
	SET_PEDDENSITY ( m02 , 600 )

	SET_CAR_DENSITY ( m03 , 400 ) 
	SET_PEDDENSITY ( m03 , 600 )

	SET_CAR_DENSITY ( m04 , 400 ) 
	SET_PEDDENSITY ( m04 , 600 )

	SET_CAR_DENSITY ( m05 , 400 ) 
	SET_PEDDENSITY ( m05 , 600 )

	SET_CAR_DENSITY ( m06 , 400 ) 
	SET_PEDDENSITY ( m06 , 600 )

	SET_CAR_DENSITY ( m07 , 400 ) 
	SET_PEDDENSITY ( m07 , 600 )

	SET_CAR_DENSITY ( m08 , 400 ) 
	SET_PEDDENSITY ( m08 , 600 )

	SET_CAR_DENSITY ( m09 , 400 ) 
	SET_PEDDENSITY ( m09 , 600 )

	SET_CAR_DENSITY ( m10 , 400 ) 
	SET_PEDDENSITY ( m10 , 600 )

	SET_CAR_DENSITY ( m11 , 400 ) 
	SET_PEDDENSITY ( m11 , 600 )

	SET_CAR_DENSITY ( m12 , 400 ) 
	SET_PEDDENSITY ( m12 , 600 )

	SET_CAR_DENSITY ( m13 , 400 ) 
	SET_PEDDENSITY ( m13 , 600 )

	SET_CAR_DENSITY ( m14 , 400 ) 
	SET_PEDDENSITY ( m14 , 600 )

	SET_CAR_DENSITY ( m15 , 400 ) 
	SET_PEDDENSITY ( m15 , 600 )

	IF ( flag_passed_kris_hard_phone_m1 = 1 )
		++ flag_kris_missions_passed
		++ flag_all_missions_passed
		IF ( flag_kris_missions_passed = 7 )
			DISPLAY_BRIEF ( 3671 ) // "Good work that should stop them building into our community"
			DISPLAY_MESSAGE ( 3670 ) // you have PASSED the mission!"
		ENDIF
	ENDIF

	IF ( flag_failed_kris_hard_phone_m1 = 1 )
		++ flag_kris_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
//		CLEAR_ALL_BRIEFS ( )
	ENDIF

	IF ( CHECK_DEATHARREST_EXECUTED ( ) )
		++ flag_kris_missions_failed
		++ flag_all_missions_failed
		CHANGE_GANG_CHAR_RESPECT_AND_UPDATE ( krisgang , shaft , -1 ) 
		CLEAR_WANTED_LEVEL ( shaft )
	ENDIF

	MISSION_HAS_FINISHED ( )
	
	SET flag_on_mission	= 0
	SET flag_on_kris_mission = 0
	
	RETURN



MISSIONSTART

	GOSUB kris_hard_phone_m1:

	GOSUB clean_up_kris_hard_phone_m1:

MISSIONEND




